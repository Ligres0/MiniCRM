@model MiniCRM.Models.Customers

@{
    ViewData["Title"] = "Müşteri Detayı";

    string initials = string.Empty;

    if (!string.IsNullOrWhiteSpace(Model.Name))
    {
        initials += Model.Name.Substring(0, 1).ToUpper();
    }

    if (!string.IsNullOrWhiteSpace(Model.Surname))
    {
        initials += Model.Surname.Substring(0, 1).ToUpper();
    }

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "?";
    }
}

<style>
    .details-page {
        max-width: 950px;
        margin: 0 auto;
    }

    .details-header {
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 12px 30px rgba(79, 70, 229, 0.20);
    }

    .profile-avatar {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background-color: rgba(255, 255, 255, 0.18);
        font-size: 1.5rem;
        font-weight: 700;
    }

    .details-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.08);
    }

    .detail-item {
        padding: 18px;
        background-color: #f8fafc;
        border-radius: 14px;
        height: 100%;
    }

    .detail-label {
        color: #64748b;
        font-size: 0.85rem;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #0f172a;
        font-weight: 600;
        word-break: break-word;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 7px 13px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .status-active {
        color: #166534;
        background: #dcfce7;
    }

    .status-passive {
        color: #991b1b;
        background: #fee2e2;
    }
</style>

<div class="container py-4">
    <div class="details-page">

        <div class="details-header mb-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center gap-3">

                <div class="profile-avatar">
                    @initials
                </div>

                <div class="flex-grow-1">
                    <div class="small opacity-75 mb-1">
                        Müşteri No: #@Model.Id
                    </div>

                    <h1 class="h3 fw-bold mb-1">
                        @Model.Name @Model.Surname
                    </h1>

                    <div class="opacity-75">
                        @(string.IsNullOrWhiteSpace(Model.CompanyName)
                            ? "Firma bilgisi bulunmuyor"
                            : Model.CompanyName)
                    </div>
                </div>

                <div>
                    @if (Model.IsActive)
                    {
                        <span class="status-badge bg-white text-success">
                            ● Aktif Müşteri
                        </span>
                    }
                    else
                    {
                        <span class="status-badge bg-white text-danger">
                            ● Pasif Müşteri
                        </span>
                    }
                </div>

            </div>
        </div>

        <div class="card details-card">
            <div class="card-body p-4 p-md-5">

                <h2 class="h5 fw-bold mb-4">
                    Müşteri Bilgileri
                </h2>

                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="detail-item">
                            <div class="detail-label">Ad</div>
                            <div class="detail-value">@Model.Name</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <div class="detail-label">Soyad</div>
                            <div class="detail-value">@Model.Surname</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <div class="detail-label">E-posta</div>

                            <div class="detail-value">
                                @(string.IsNullOrWhiteSpace(Model.Email)
                                    ? "E-posta bilgisi bulunmuyor"
                                    : Model.Email)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <div class="detail-label">Telefon</div>

                            <div class="detail-value">
                                @(string.IsNullOrWhiteSpace(Model.Phone)
                                    ? "Telefon bilgisi bulunmuyor"
                                    : Model.Phone)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <div class="detail-label">Firma</div>

                            <div class="detail-value">
                                @(string.IsNullOrWhiteSpace(Model.CompanyName)
                                    ? "Firma bilgisi bulunmuyor"
                                    : Model.CompanyName)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <div class="detail-label">Kayıt Tarihi</div>

                            <div class="detail-value">
                                @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <div class="detail-label">Durum</div>

                            <div class="detail-value">
                                @if (Model.IsActive)
                                {
                                    <span class="status-badge status-active">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-passive">
                                        Pasif
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">

                    <a asp-controller="Customer"
                       asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Listeye Dön
                    </a>

                    <a asp-controller="Customer"
                       asp-action="Update"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary px-4">
                        Müşteriyi Düzenle
                    </a>

                </div>

            </div>
        </div>

    </div>
</div>