@using Microsoft.AspNetCore.Http
@inject MiniCRM.Services.IAuthorizationService AuthorizationService

@{
    int? userId = Context.Session.GetInt32("UserId");

    bool isLoggedIn = userId.HasValue;

    bool canViewDashboard =
        isLoggedIn &&
        AuthorizationService.HasPermission(
            userId!.Value,
            "Dashboard.View");

    bool canViewCustomers =
        isLoggedIn &&
        AuthorizationService.HasPermission(
            userId!.Value,
            "Customer.View");

    bool canViewProducts =
        isLoggedIn &&
        AuthorizationService.HasPermission(
            userId!.Value,
            "Product.View");

    bool canViewOrders =
        isLoggedIn &&
        AuthorizationService.HasPermission(
            userId!.Value,
            "Order.View");
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - MiniCRM
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/MiniCRM.styles.css"
          asp-append-version="true" />

</head>


<body>

    <header>

        <nav class="navbar
            navbar-expand-lg
            navbar-light
            bg-white
            border-bottom
            box-shadow
            mb-3">

            <div class="container-fluid">

                <!-- Logo -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                    MiniCRM

                </a>


                <!-- Mobile menu button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse"
                     id="mainNavbar">


                    <!-- Sol taraf -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">


                        <!-- Dashboard -->
                        @if (canViewDashboard)
                        {
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Dashboard"
                                   asp-action="Index">

                                    Dashboard

                                </a>

                            </li>
                        }


                        <!-- Customers -->
                        @if (canViewCustomers)
                        {
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Customer"
                                   asp-action="Index">

                                    @Localization.GetText("CustomerManagement")

                                </a>

                            </li>
                        }


                        <!-- Products -->
                        @if (canViewProducts)
                        {
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Product"
                                   asp-action="Index">

                                    @Localization.GetText("Products")

                                </a>

                            </li>


                            <!-- Category de Product.View kullanıyor -->
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Category"
                                   asp-action="Index">

                                    @Localization.GetText("Categories")

                                </a>

                            </li>
                        }


                        <!-- Orders -->
                        @if (canViewOrders)
                        {
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Order"
                                   asp-action="Index">

                                    @Localization.GetText("Orders")

                                </a>

                            </li>
                        }

                    </ul>


                    <!-- Sağ taraf -->
                    <ul class="navbar-nav ms-auto">

                        @if (isLoggedIn)
                        {
                            <li class="nav-item">

                                <form asp-controller="Auth"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-danger">

                                        Logout

                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">

                                <a asp-controller="Auth"
                                   asp-action="Login"
                                   class="btn btn-outline-primary">

                                    Login

                                </a>

                            </li>
                        }

                    </ul>


                </div>

            </div>

        </nav>

    </header>


    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - MiniCRM

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>