@model MiniCRM.ViewModels.OrderListViewModel

@{
    ViewData["Title"] = "Orders";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Order Management</h2>
            <p class="text-muted mb-0">
                Manage customer orders.
            </p>
        </div>

        <a asp-controller="Order"
           asp-action="Create"
           class="btn btn-primary">
            Create New Order
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <form asp-controller="Order"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">
                            Order Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="Order number" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            Customer
                        </label>

                        <select name="customerId"
                                class="form-select">
                            <option value="">
                                All Customers
                            </option>

                            @foreach (var customer in Model.Customers)
                            {
                                if (Model.CustomerId == customer.Id)
                                {
                                    <option value="@customer.Id" selected>
                                        @customer.Name @customer.Surname
                                    </option>
                                }
                                else
                                {
                                    <option value="@customer.Id">
                                        @customer.Name @customer.Surname
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">
                            <option value="">
                                All Statuses
                            </option>

                            @foreach (var status in Enum.GetValues<
                                MiniCRM.Models.Order.OrderStatus>())
                            {
                                if (Model.Status == status)
                                {
                                    <option value="@status" selected>
                                        @status
                                    </option>
                                }
                                else
                                {
                                    <option value="@status">
                                        @status
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-3 d-flex align-items-end gap-2">
                        <button type="submit"
                                class="btn btn-dark">
                            Filter
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Clear
                        </a>
                    </div>
                </div>

                <input type="hidden"
                       name="pageSize"
                       value="@Model.PageSize" />
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model.Orders.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No orders were found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Order No</th>
                                <th>Customer ID</th>
                                <th>Order Date</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td>#@order.Id</td>
                                    <td>@order.CustomerId</td>
                                    <td>
                                        @order.OrderDate.ToString(
                                            "dd.MM.yyyy HH:mm")
                                    </td>
                                    <td>
                                        @order.TotalAmount.ToString("N2") TL
                                    </td>
                                    <td>
                                        @if (order.Status ==
                                            MiniCRM.Models.Order.OrderStatus.Draft)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Draft
                                            </span>
                                        }
                                        else if (order.Status ==
                                            MiniCRM.Models.Order.OrderStatus.Completed)
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <a asp-action="Details"
                                           asp-route-id="@order.Id"
                                           class="btn btn-sm btn-outline-info">
                                            Details
                                        </a>

                                        @if (order.Status ==
                                            MiniCRM.Models.Order.OrderStatus.Draft)
                                        {
                                            <a asp-action="Update"
                                               asp-route-id="@order.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Update
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item
                    @(Model.CurrentPage <= 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-customerId="@Model.CustomerId"
                       asp-route-status="@Model.Status"
                       asp-route-pageNumber="@(Model.CurrentPage - 1)"
                       asp-route-pageSize="@Model.PageSize">
                        Previous
                    </a>
                </li>

                @for (int pageNumberItem = 1;
                      pageNumberItem <= Model.TotalPages;
                      pageNumberItem++)
                {
                    <li class="page-item @(pageNumberItem == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-customerId="@Model.CustomerId"
                           asp-route-status="@Model.Status"
                           asp-route-pageNumber="@pageNumberItem"
                           asp-route-pageSize="@Model.PageSize">
                            @pageNumberItem
                        </a>
                    </li>
                }

                <li class="page-item
                    @(Model.CurrentPage >= Model.TotalPages
                        ? "disabled"
                        : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-customerId="@Model.CustomerId"
                       asp-route-status="@Model.Status"
                       asp-route-pageNumber="@(Model.CurrentPage + 1)"
                       asp-route-pageSize="@Model.PageSize">
                        Next
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>