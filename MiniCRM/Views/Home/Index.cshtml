@inject MiniCRM.Services.ILocalizationService Localization

@{
    ViewData["Title"] = "Mini CRM";

    var returnUrl =
        Context.Request.Path + Context.Request.QueryString;
}

<style>
    .home-page {
        --primary: #4f46e5;
        --secondary: #7c3aed;
        --dark: #0f172a;
        --muted: #64748b;
        --light-purple: #eef2ff;
        --border: #e5e7eb;
    }

    .language-bar {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-bottom: 18px;
    }

    .hero-section {
        position: relative;
        overflow: hidden;
        padding: 64px 48px;
        border-radius: 26px;
        color: white;
        background: linear-gradient( 135deg, var(--primary), var(--secondary) );
        box-shadow: 0 20px 50px rgba(79, 70, 229, 0.24);
    }

        .hero-section::after {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            top: -100px;
            right: -80px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.09);
        }

        .hero-section::before {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            right: 170px;
            bottom: -120px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.07);
        }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 850px;
    }

    .hero-title {
        max-width: 800px;
        font-size: clamp(2rem, 5vw, 3.6rem);
        font-weight: 800;
        line-height: 1.1;
    }

    .hero-description {
        max-width: 720px;
        font-size: 1.08rem;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.84);
    }

    .section-title {
        color: var(--dark);
        font-weight: 800;
    }

    .section-description {
        color: var(--muted);
    }

    .feature-link {
        color: inherit;
        text-decoration: none;
    }

        .feature-link:hover {
            color: inherit;
        }

    .feature-card {
        height: 100%;
        border: 0;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.07);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 17px 40px rgba(15, 23, 42, 0.13);
        }

    .feature-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 58px;
        height: 58px;
        border-radius: 17px;
        background: var(--light-purple);
        color: var(--primary);
        font-size: 1.35rem;
        font-weight: 800;
    }

    .feature-title {
        color: var(--dark);
        font-weight: 750;
    }

    .feature-description {
        color: var(--muted);
        font-size: 0.94rem;
        line-height: 1.6;
    }

    .module-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 23px;
        border: 1px solid var(--border);
        border-radius: 19px;
        background: white;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .module-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 13px 30px rgba(15, 23, 42, 0.09);
        }

    .module-status {
        display: inline-block;
        padding: 5px 11px;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 700;
    }

    .status-ready {
        color: #166534;
        background: #dcfce7;
    }

    .status-planned {
        color: #475569;
        background: #f1f5f9;
    }

    .development-card {
        height: 100%;
        padding: 22px;
        border-radius: 18px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    .development-number {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        margin-bottom: 16px;
        border-radius: 13px;
        color: white;
        background: linear-gradient( 135deg, var(--primary), var(--secondary) );
        font-weight: 800;
    }

    .development-card h3 {
        color: var(--dark);
        font-size: 1rem;
        font-weight: 750;
    }

    .development-card p {
        margin-bottom: 0;
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.6;
    }

    @@media (max-width: 767px) {
        .hero-section {
            padding: 42px 25px;
        }
    }
</style>

<div class="container py-5 home-page">

    <!-- Language Selection -->
    <div class="language-bar">

        <a asp-controller="Localization"
           asp-action="ChangeLanguage"
           asp-route-culture="tr-TR"
           asp-route-returnUrl="@returnUrl"
           class="btn btn-sm btn-outline-primary">
            Türkçe
        </a>

        <a asp-controller="Localization"
           asp-action="ChangeLanguage"
           asp-route-culture="en-US"
           asp-route-returnUrl="@returnUrl"
           class="btn btn-sm btn-outline-primary">
            English
        </a>

    </div>

    <!-- Hero -->
    <section class="hero-section mb-5">

        <div class="hero-content">

            <span class="badge bg-light text-primary mb-3 px-3 py-2">
                @Localization.GetText("HomeBadge")
            </span>

            <h1 class="hero-title mb-3">
                @Localization.GetText("HomeTitle")
            </h1>

            <p class="hero-description mb-4">
                @Localization.GetText("HomeDescription")
            </p>

            <div class="d-flex flex-column flex-sm-row flex-wrap gap-3">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="btn btn-light btn-lg px-4 fw-semibold">
                    @Localization.GetText("OpenDashboard")
                </a>

                <a asp-controller="Order"
                   asp-action="Create"
                   class="btn btn-outline-light btn-lg px-4">
                    @Localization.GetText("NewOrder")
                </a>

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="btn btn-outline-light btn-lg px-4">
                    @Localization.GetText("Customers")
                </a>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-outline-light btn-lg px-4">
                    @Localization.GetText("Products")
                </a>

            </div>

        </div>

    </section>

    <!-- Main Modules -->
    <section class="mb-5">

        <div class="text-center mb-4">

            <h2 class="section-title">
                @Localization.GetText("ManagementScreens")
            </h2>

            <p class="section-description">
                @Localization.GetText("ManagementScreensDescription")
            </p>

        </div>

        <div class="row g-4">

            <!-- Dashboard -->
            <div class="col-md-6 col-lg-4">

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="feature-link">

                    <div class="card feature-card">

                        <div class="card-body p-4">

                            <div class="feature-icon mb-4">
                                D
                            </div>

                            <h3 class="h5 feature-title">
                                @Localization.GetText("Dashboard")
                            </h3>

                            <p class="feature-description mb-0">
                                @Localization.GetText(
                                    "DashboardDescription")
                            </p>

                        </div>

                    </div>

                </a>

            </div>

            <!-- Customers -->
            <div class="col-md-6 col-lg-4">

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="feature-link">

                    <div class="card feature-card">

                        <div class="card-body p-4">

                            <div class="feature-icon mb-4">
                                M
                            </div>

                            <h3 class="h5 feature-title">
                                @Localization.GetText(
                                    "CustomerManagement")
                            </h3>

                            <p class="feature-description mb-0">
                                @Localization.GetText(
                                    "CustomerManagementDescription")
                            </p>

                        </div>

                    </div>

                </a>

            </div>

            <!-- Products -->
            <div class="col-md-6 col-lg-4">

                <a asp-controller="Product"
                   asp-action="Index"
                   class="feature-link">

                    <div class="card feature-card">

                        <div class="card-body p-4">

                            <div class="feature-icon mb-4">
                                Ü
                            </div>

                            <h3 class="h5 feature-title">
                                @Localization.GetText(
                                    "ProductManagement")
                            </h3>

                            <p class="feature-description mb-0">
                                @Localization.GetText(
                                    "ProductManagementDescription")
                            </p>

                        </div>

                    </div>

                </a>

            </div>

            <!-- Categories -->
            <div class="col-md-6 col-lg-4">

                <a asp-controller="Category"
                   asp-action="Index"
                   class="feature-link">

                    <div class="card feature-card">

                        <div class="card-body p-4">

                            <div class="feature-icon mb-4">
                                K
                            </div>

                            <h3 class="h5 feature-title">
                                @Localization.GetText(
                                    "CategoryManagement")
                            </h3>

                            <p class="feature-description mb-0">
                                @Localization.GetText(
                                    "CategoryManagementDescription")
                            </p>

                        </div>

                    </div>

                </a>

            </div>

            <!-- Orders -->
            <div class="col-md-6 col-lg-4">

                <a asp-controller="Order"
                   asp-action="Index"
                   class="feature-link">

                    <div class="card feature-card">

                        <div class="card-body p-4">

                            <div class="feature-icon mb-4">
                                S
                            </div>

                            <h3 class="h5 feature-title">
                                @Localization.GetText(
                                    "OrderManagement")
                            </h3>

                            <p class="feature-description mb-0">
                                @Localization.GetText(
                                    "OrderManagementDescription")
                            </p>

                        </div>

                    </div>

                </a>

            </div>

            <!-- New Order -->
            <div class="col-md-6 col-lg-4">

                <a asp-controller="Order"
                   asp-action="Create"
                   class="feature-link">

                    <div class="card feature-card">

                        <div class="card-body p-4">

                            <div class="feature-icon mb-4">
                                +
                            </div>

                            <h3 class="h5 feature-title">
                                @Localization.GetText(
                                    "QuickCreateOrder")
                            </h3>

                            <p class="feature-description mb-0">
                                @Localization.GetText(
                                    "QuickCreateOrderDescription")
                            </p>

                        </div>

                    </div>

                </a>

            </div>

        </div>

    </section>

    <!-- Developed Features -->
    <section class="mb-5">

        <div class="mb-4">

            <h2 class="section-title mb-1">
                @Localization.GetText("DevelopedFeatures")
            </h2>

            <p class="section-description mb-0">
                @Localization.GetText(
                    "DevelopedFeaturesDescription")
            </p>

        </div>

        <div class="row g-3">

            <!-- Layered Architecture -->
            <div class="col-md-6 col-lg-3">

                <div class="development-card">

                    <div class="development-number">
                        1
                    </div>

                    <h3>
                        @Localization.GetText(
                            "LayeredArchitecture")
                    </h3>

                    <p>
                        @Localization.GetText(
                            "LayeredArchitectureDescription")
                    </p>

                </div>

            </div>

            <!-- Transaction -->
            <div class="col-md-6 col-lg-3">

                <div class="development-card">

                    <div class="development-number">
                        2
                    </div>

                    <h3>
                        @Localization.GetText(
                            "TransactionAndStock")
                    </h3>

                    <p>
                        @Localization.GetText(
                            "TransactionAndStockDescription")
                    </p>

                </div>

            </div>

            <!-- Ajax -->
            <div class="col-md-6 col-lg-3">

                <div class="development-card">

                    <div class="development-number">
                        3
                    </div>

                    <h3>
                        @Localization.GetText(
                            "AjaxOperations")
                    </h3>

                    <p>
                        @Localization.GetText(
                            "AjaxOperationsDescription")
                    </p>

                </div>

            </div>

            <!-- Reporting -->
            <div class="col-md-6 col-lg-3">

                <div class="development-card">

                    <div class="development-number">
                        4
                    </div>

                    <h3>
                        @Localization.GetText(
                            "ReportingAndDashboard")
                    </h3>

                    <p>
                        @Localization.GetText(
                            "ReportingAndDashboardDescription")
                    </p>

                </div>

            </div>

        </div>

    </section>

    <!-- Module Status -->
    <section>

        <div class="d-flex flex-column
            flex-md-row
            justify-content-between
            align-items-md-end
            gap-3
            mb-4">

            <div>

                <h2 class="section-title mb-1">
                    @Localization.GetText(
                        "ApplicationModules")
                </h2>

                <p class="section-description mb-0">
                    @Localization.GetText(
                        "ApplicationModulesDescription")
                </p>

            </div>

            <div class="d-flex flex-wrap gap-2">

                <a asp-controller="Customer"
                   asp-action="Create"
                   class="btn btn-outline-primary">
                    @Localization.GetText("NewCustomer")
                </a>

                <a asp-controller="Product"
                   asp-action="Create"
                   class="btn btn-outline-primary">
                    @Localization.GetText("NewProduct")
                </a>

                <a asp-controller="Category"
                   asp-action="Create"
                   class="btn btn-outline-primary">
                    @Localization.GetText("NewCategory")
                </a>

                <a asp-controller="Order"
                   asp-action="Create"
                   class="btn btn-primary">
                    @Localization.GetText("NewOrder")
                </a>

            </div>

        </div>

        <div class="row g-3">

            <!-- Dashboard Status -->
            <div class="col-md-6 col-lg-4">

                <div class="module-card">

                    <div class="d-flex
                        justify-content-between
                        align-items-start
                        mb-3">

                        <h3 class="h5 fw-bold mb-0">
                            @Localization.GetText("Dashboard")
                        </h3>

                        <span class="module-status status-ready">
                            @Localization.GetText("Ready")
                        </span>

                    </div>

                    <p class="text-secondary">
                        @Localization.GetText(
                            "DashboardModuleDescription")
                    </p>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-sm
                        btn-outline-primary
                        mt-auto
                        align-self-start">
                        @Localization.GetText("OpenDashboard")
                    </a>

                </div>

            </div>

            <!-- Customer Status -->
            <div class="col-md-6 col-lg-4">

                <div class="module-card">

                    <div class="d-flex
                        justify-content-between
                        align-items-start
                        mb-3">

                        <h3 class="h5 fw-bold mb-0">
                            @Localization.GetText("Customers")
                        </h3>

                        <span class="module-status status-ready">
                            @Localization.GetText("Ready")
                        </span>

                    </div>

                    <p class="text-secondary">
                        @Localization.GetText(
                            "CustomersModuleDescription")
                    </p>

                    <a asp-controller="Customer"
                       asp-action="Index"
                       class="btn btn-sm
                        btn-outline-primary
                        mt-auto
                        align-self-start">
                        @Localization.GetText("OpenModule")
                    </a>

                </div>

            </div>

            <!-- Category Status -->
            <div class="col-md-6 col-lg-4">

                <div class="module-card">

                    <div class="d-flex
                        justify-content-between
                        align-items-start
                        mb-3">

                        <h3 class="h5 fw-bold mb-0">
                            @Localization.GetText("Categories")
                        </h3>

                        <span class="module-status status-ready">
                            @Localization.GetText("Ready")
                        </span>

                    </div>

                    <p class="text-secondary">
                        @Localization.GetText(
                            "CategoriesModuleDescription")
                    </p>

                    <a asp-controller="Category"
                       asp-action="Index"
                       class="btn btn-sm
                        btn-outline-primary
                        mt-auto
                        align-self-start">
                        @Localization.GetText("OpenModule")
                    </a>

                </div>

            </div>

            <!-- Product Status -->
            <div class="col-md-6 col-lg-4">

                <div class="module-card">

                    <div class="d-flex
                        justify-content-between
                        align-items-start
                        mb-3">

                        <h3 class="h5 fw-bold mb-0">
                            @Localization.GetText("Products")
                        </h3>

                        <span class="module-status status-ready">
                            @Localization.GetText("Ready")
                        </span>

                    </div>

                    <p class="text-secondary">
                        @Localization.GetText(
                            "ProductsModuleDescription")
                    </p>

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="btn btn-sm
                        btn-outline-primary
                        mt-auto
                        align-self-start">
                        @Localization.GetText("OpenModule")
                    </a>

                </div>

            </div>

            <!-- Order Status -->
            <div class="col-md-6 col-lg-4">

                <div class="module-card">

                    <div class="d-flex
                        justify-content-between
                        align-items-start
                        mb-3">

                        <h3 class="h5 fw-bold mb-0">
                            @Localization.GetText("Orders")
                        </h3>

                        <span class="module-status status-ready">
                            @Localization.GetText("Ready")
                        </span>

                    </div>

                    <p class="text-secondary">
                        @Localization.GetText(
                            "OrdersModuleDescription")
                    </p>

                    <a asp-controller="Order"
                       asp-action="Index"
                       class="btn btn-sm
                        btn-outline-primary
                        mt-auto
                        align-self-start">
                        @Localization.GetText("OpenModule")
                    </a>

                </div>

            </div>

            <!-- Users Status -->
            <div class="col-md-6 col-lg-4">

                <div class="module-card">

                    <div class="d-flex
                        justify-content-between
                        align-items-start
                        mb-3">

                        <h3 class="h5 fw-bold mb-0">
                            @Localization.GetText("Users")
                        </h3>

                        <span class="module-status status-planned">
                            @Localization.GetText("Planned")
                        </span>

                    </div>

                    <p class="text-secondary mb-0">
                        @Localization.GetText(
                            "UsersModuleDescription")
                    </p>

                </div>

            </div>

        </div>

    </section>

</div>