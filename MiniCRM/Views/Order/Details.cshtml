@model MiniCRM.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] =
        Localization.GetText("OrderDetails");

    var completeConfirm =
        Localization.GetText("ConfirmCompleteOrder");

    string statusText =
        Model.Order.Status switch
        {
            MiniCRM.Models.Order.OrderStatus.Draft =>
                Localization.GetText("StatusDraft"),

            MiniCRM.Models.Order.OrderStatus.Completed =>
                Localization.GetText("StatusCompleted"),

            MiniCRM.Models.Order.OrderStatus.Cancelled =>
                Localization.GetText("StatusCancelled"),

            _ => Model.Order.Status.ToString()
        };
}

<div class="container mt-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <div class="d-flex
        justify-content-between
        align-items-center
        mb-4">

        <div>

            <h2>
                @Localization.GetText("Order")
                #@Model.Order.Id
            </h2>

            <p class="text-muted mb-0">
                @Localization.GetText("OrderDetailsDescription")
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            @Localization.GetText("BackToOrders")

        </a>

    </div>


    <!-- Order Info -->
    <div class="card mb-4">

        <div class="card-header">
            @Localization.GetText("OrderInformation")
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <strong>
                        @Localization.GetText("Customer")
                    </strong>

                    <div>
                        @Model.CustomerName
                    </div>

                </div>


                <div class="col-md-4">

                    <strong>
                        @Localization.GetText("OrderDate")
                    </strong>

                    <div>

                        @Model.Order.OrderDate.ToString(
                            "dd.MM.yyyy HH:mm"
                        )

                    </div>

                </div>


                <div class="col-md-4">

                    <strong>
                        @Localization.GetText("Status")
                    </strong>

                    <div>
                        @statusText
                    </div>

                </div>


                <div class="col-md-4">

                    <strong>
                        @Localization.GetText("CreatedByUserId")
                    </strong>

                    <div>
                        @Model.Order.CreatedByUserId
                    </div>

                </div>


                <div class="col-md-4">

                    <strong>
                        @Localization.GetText("TotalAmount")
                    </strong>

                    <div>
                        @Model.Order.TotalAmount.ToString("N2") TL
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Products -->
    <div class="card mb-4">

        <div class="card-header">
            @Localization.GetText("Products")
        </div>

        <div class="card-body">

            @if (Model.Items.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    @Localization.GetText("NoProductsInOrder")
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead>

                            <tr>

                                <th>
                                    @Localization.GetText("Product")
                                </th>

                                <th>
                                    @Localization.GetText("Quantity")
                                </th>

                                <th>
                                    @Localization.GetText("UnitPrice")
                                </th>

                                <th>
                                    @Localization.GetText("LineTotal")
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.Items)
                            {
                                <tr>

                                    <td>
                                        @item.ProductName
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>
                                        @item.UnitPrice.ToString("N2") TL
                                    </td>

                                    <td>
                                        @item.TotalPrice.ToString("N2") TL
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    @if (
        Model.Order.Status ==
        MiniCRM.Models.Order.OrderStatus.Draft
    )
    {
        <div class="d-flex gap-2">

            <a asp-action="Update"
               asp-route-id="@Model.Order.Id"
               class="btn btn-primary">

                @Localization.GetText("UpdateOrder")

            </a>


            <form asp-action="Complete"
                  asp-route-id="@Model.Order.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-success"
                        onclick="return confirm('@completeConfirm');">

                    @Localization.GetText("Complete")

                </button>

            </form>


            <form asp-controller="Order"
                  asp-action="Cancel"
                  asp-route-id="@Model.Order.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger">

                    @Localization.GetText("CancelOrder")

                </button>

            </form>

        </div>
    }

</div>