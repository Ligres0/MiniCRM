@model MiniCRM.ViewModels.ProductFormViewModel

@{
    ViewData["Title"] = Localization.GetText("CreateProduct");

    var productNamePlaceholder =
        Localization.GetText("EnterProductName");
}

<div class="container py-4">

    <div class="mx-auto" style="max-width: 800px;">

        <div class="mb-4">

            <h1 class="fw-bold">
                @Localization.GetText("CreateProduct")
            </h1>

            <p class="text-muted">
                @Localization.GetText("EnterProductInformation")
            </p>

        </div>

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4">

                <form asp-controller="Product"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">

                                @Localization.GetText("ProductName")

                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="@productNamePlaceholder" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="CategoryId"
                                   class="form-label fw-semibold">

                                @Localization.GetText("Category")

                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select">

                                <option value="0">
                                    @Localization.GetText("SelectCategory")
                                </option>

                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="Price"
                                   class="form-label fw-semibold">

                                @Localization.GetText("Price")

                            </label>

                            <input asp-for="Price"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control" />

                            <span asp-validation-for="Price"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="Stock"
                                   class="form-label fw-semibold">

                                @Localization.GetText("Stock")

                            </label>

                            <input asp-for="Stock"
                                   type="number"
                                   min="0"
                                   class="form-control" />

                            <span asp-validation-for="Stock"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-12">

                            <div class="form-check form-switch">

                                <input asp-for="IsActive"
                                       class="form-check-input" />

                                <label asp-for="IsActive"
                                       class="form-check-label fw-semibold">

                                    @Localization.GetText("ProductIsActive")

                                </label>

                            </div>

                        </div>

                        <div class="col-12">

                            <hr />

                            <div class="d-flex justify-content-end gap-2">

                                <a asp-controller="Product"
                                   asp-action="Index"
                                   class="btn btn-outline-secondary">

                                    @Localization.GetText("Cancel")

                                </a>

                                <button type="submit"
                                        class="btn btn-primary">

                                    @Localization.GetText("SaveProduct")

                                </button>

                            </div>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}