@model List<MiniCRM.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="container py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">Categories</h1>
            <p class="text-muted mb-0">
                Manage product categories.
            </p>
        </div>

        <a asp-controller="Category"
           asp-action="Create"
           class="btn btn-primary">
            + New Category
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">

            @if (Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Id</th>
                                <th>Name</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        #@category.Id
                                    </td>

                                    <td>
                                        <strong>@category.Name</strong>
                                    </td>

                                    <td>
                                        @if (category.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">

                                        <a asp-controller="Category"
                                           asp-action="Details"
                                           asp-route-id="@category.Id"
                                           class="btn btn-sm btn-outline-info">
                                            Details
                                        </a>

                                        <a asp-controller="Category"
                                           asp-action="Update"
                                           asp-route-id="@category.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        @if (category.IsActive)
                                        {
                                            <form asp-controller="Category"
                                                  asp-action="Deactivate"
                                                  asp-route-id="@category.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Are you sure you want to deactivate this category?');">
                                                    Deactivate
                                                </button>
                                            </form>
                                        }

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h3 class="h5">No categories found.</h3>

                    <a asp-controller="Category"
                       asp-action="Create"
                       class="btn btn-primary mt-2">
                        Create First Category
                    </a>
                </div>
            }

        </div>
    </div>

</div>