@model MiniCRM.ViewModels.OrderCreateViewModel

@{
    ViewData["Title"] = "Create Order";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2>Create New Order</h2>

        <p class="text-muted">
            Select a customer and add products to the order.
        </p>
    </div>

    <form asp-controller="Order"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <!-- Customer -->
        <div class="card mb-4">
            <div class="card-header">
                Customer Information
            </div>

            <div class="card-body">
                <label asp-for="CustomerId"
                       class="form-label">
                    Customer
                </label>

                <select asp-for="CustomerId"
                        id="customerSelect"
                        class="form-select">

                    <option value="0">
                        Select Customer
                    </option>

                    @foreach (var customer in Model.Customers)
                    {
                        <option value="@customer.Id">
                            @customer.Name @customer.Surname
                        </option>
                    }
                </select>

                <span asp-validation-for="CustomerId"
                      class="text-danger">
                </span>

                <!-- AJAX Customer Summary -->
                <div id="customerSummary"
                     class="alert alert-light border mt-3 d-none">

                    <h6 class="mb-3">
                        Customer Summary
                    </h6>

                    <div>
                        <strong>Name:</strong>

                        <span id="customerFullName">
                            -
                        </span>
                    </div>

                    <div>
                        <strong>Company:</strong>

                        <span id="customerCompany">
                            -
                        </span>
                    </div>

                    <div>
                        <strong>Email:</strong>

                        <span id="customerEmail">
                            -
                        </span>
                    </div>

                    <div>
                        <strong>Phone:</strong>

                        <span id="customerPhone">
                            -
                        </span>
                    </div>

                    <div id="customerError"
                         class="text-danger mt-2">
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Items -->
        <div class="card mb-4">
            <div class="card-header d-flex
                justify-content-between
                align-items-center">

                <span>Order Items</span>

                <button type="button"
                        id="addItemButton"
                        class="btn btn-sm btn-success">
                    Add Product
                </button>
            </div>

            <div class="card-body">
                <div id="orderItemsContainer">

                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        <div class="order-item row g-3
                            align-items-end mb-3
                            border-bottom pb-3">

                            <!-- Product -->
                            <div class="col-md-5">
                                <label class="form-label">
                                    Product
                                </label>

                                <select asp-for="Items[i].ProductId"
                                        class="form-select product-select"
                                        data-field="ProductId">

                                    <option value="0">
                                        Select Product
                                    </option>

                                    @foreach (var product in Model.Products)
                                    {
                                        <option value="@product.Id">
                                            @product.Name
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="Items[i].ProductId"
                                      class="text-danger">
                                </span>

                                <div class="mt-2 small">
                                    <span class="me-3">
                                        Price:

                                        <strong class="product-price">
                                            -
                                        </strong>

                                        TL
                                    </span>

                                    <span>
                                        Available Stock:

                                        <strong class="product-stock">
                                            -
                                        </strong>
                                    </span>
                                </div>

                                <div class="product-error
                                    text-danger small mt-1">
                                </div>
                            </div>

                            <!-- Quantity -->
                            <div class="col-md-2">
                                <label class="form-label">
                                    Quantity
                                </label>

                                <input asp-for="Items[i].Quantity"
                                       class="form-control quantity-input"
                                       data-field="Quantity"
                                       type="number"
                                       min="1" />

                                <span asp-validation-for="Items[i].Quantity"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Line Total -->
                            <div class="col-md-3">
                                <label class="form-label">
                                    Line Total
                                </label>

                                <div class="form-control bg-light">
                                    <span class="line-total">
                                        0,00
                                    </span>

                                    TL
                                </div>
                            </div>

                            <!-- Remove -->
                            <div class="col-md-2">
                                <button type="button"
                                        class="btn btn-outline-danger
                                    remove-item-button">

                                    Remove
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div id="emptyOrderMessage"
                     class="alert alert-secondary">

                    Click “Add Product” to add an order item.
                </div>
            </div>
        </div>

        <!-- Order Total -->
        <div class="card mb-4">
            <div class="card-body d-flex
                justify-content-between
                align-items-center">

                <strong>Order Total</strong>

                <div class="fs-4">
                    <span id="orderTotal">
                        0,00
                    </span>

                    TL
                </div>
            </div>
        </div>

        <!-- Buttons -->
        <div class="d-flex justify-content-end gap-2">
            <a href="@Url.Action("Index", "Order")"
               class="btn btn-outline-secondary">

                Cancel
            </a>

            <button type="submit"
                    class="btn btn-primary">

                Save Order
            </button>
        </div>
    </form>
</div>

<!-- Dynamic Order Item Template -->
<template id="orderItemTemplate">
    <div class="order-item row g-3
        align-items-end mb-3
        border-bottom pb-3">

        <!-- Product -->
        <div class="col-md-5">
            <label class="form-label">
                Product
            </label>

            <select class="form-select product-select"
                    data-field="ProductId">

                <option value="0">
                    Select Product
                </option>

                @foreach (var product in Model.Products)
                {
                    <option value="@product.Id">
                        @product.Name
                    </option>
                }
            </select>

            <div class="mt-2 small">
                <span class="me-3">
                    Price:

                    <strong class="product-price">
                        -
                    </strong>

                    TL
                </span>

                <span>
                    Available Stock:

                    <strong class="product-stock">
                        -
                    </strong>
                </span>
            </div>

            <div class="product-error
                text-danger small mt-1">
            </div>
        </div>

        <!-- Quantity -->
        <div class="col-md-2">
            <label class="form-label">
                Quantity
            </label>

            <input type="number"
                   class="form-control quantity-input"
                   data-field="Quantity"
                   value="1"
                   min="1" />
        </div>

        <!-- Line Total -->
        <div class="col-md-3">
            <label class="form-label">
                Line Total
            </label>

            <div class="form-control bg-light">
                <span class="line-total">
                    0,00
                </span>

                TL
            </div>
        </div>

        <!-- Remove -->
        <div class="col-md-2">
            <button type="button"
                    class="btn btn-outline-danger
                remove-item-button">

                Remove
            </button>
        </div>
    </div>
</template>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        const container =
            document.getElementById("orderItemsContainer");

        const template =
            document.getElementById("orderItemTemplate");

        const addButton =
            document.getElementById("addItemButton");

        const emptyMessage =
            document.getElementById("emptyOrderMessage");

        const orderTotalElement =
            document.getElementById("orderTotal");

        const customerSelect =
            document.getElementById("customerSelect");

        const customerSummary =
            document.getElementById("customerSummary");

        const customerFullName =
            document.getElementById("customerFullName");

        const customerCompany =
            document.getElementById("customerCompany");

        const customerEmail =
            document.getElementById("customerEmail");

        const customerPhone =
            document.getElementById("customerPhone");

        const customerError =
            document.getElementById("customerError");

        const productInfoUrl =
            '@Url.Action("GetProductInfo", "Order")';

        const customerInfoUrl =
            '@Url.Action("GetCustomerInfo", "Order")';

        function formatMoney(value) {
            const number = Number(value);

            if (!Number.isFinite(number)) {
                return "0,00";
            }

            return number.toLocaleString("tr-TR", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function clearCustomerInfo() {
            customerSummary.classList.add("d-none");

            customerFullName.textContent = "-";
            customerCompany.textContent = "-";
            customerEmail.textContent = "-";
            customerPhone.textContent = "-";
            customerError.textContent = "";
        }

        async function loadCustomerInfo() {
            const customerId =
                Number(customerSelect.value);

            if (!customerId || customerId <= 0) {
                clearCustomerInfo();
                return;
            }

            customerSummary.classList.remove("d-none");

            customerFullName.textContent = "...";
            customerCompany.textContent = "...";
            customerEmail.textContent = "...";
            customerPhone.textContent = "...";
            customerError.textContent = "";

            try {
                const response = await fetch(
                    `${customerInfoUrl}?customerId=${encodeURIComponent(customerId)}`,
                    {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    }
                );

                if (!response.ok) {
                    throw new Error(
                        "Customer information could not be loaded."
                    );
                }

                const customer =
                    await response.json();

                const fullName =
                    `${customer.name ?? ""} ${customer.surname ?? ""}`
                        .trim();

                customerFullName.textContent =
                    fullName || "-";

                customerCompany.textContent =
                    customer.companyName || "-";

                customerEmail.textContent =
                    customer.email || "-";

                customerPhone.textContent =
                    customer.phone || "-";
            }
            catch (error) {
                customerFullName.textContent = "-";
                customerCompany.textContent = "-";
                customerEmail.textContent = "-";
                customerPhone.textContent = "-";

                customerError.textContent =
                    error.message;
            }
        }

        function updateIndexes() {
            const items =
                container.querySelectorAll(".order-item");

            items.forEach((item, index) => {
                const product =
                    item.querySelector(
                        '[data-field="ProductId"]'
                    );

                const quantity =
                    item.querySelector(
                        '[data-field="Quantity"]'
                    );

                if (product) {
                    product.name =
                        `Items[${index}].ProductId`;

                    product.id =
                        `Items_${index}__ProductId`;
                }

                if (quantity) {
                    quantity.name =
                        `Items[${index}].Quantity`;

                    quantity.id =
                        `Items_${index}__Quantity`;
                }
            });

            emptyMessage.style.display =
                items.length === 0
                    ? "block"
                    : "none";
        }

        function updateOrderTotal() {
            const items =
                container.querySelectorAll(".order-item");

            let total = 0;

            items.forEach(item => {
                const lineTotal =
                    Number(item.dataset.lineTotal || 0);

                total += lineTotal;
            });

            orderTotalElement.textContent =
                formatMoney(total);
        }

        function updateLineTotal(item) {
            const quantityInput =
                item.querySelector(".quantity-input");

            const lineTotalElement =
                item.querySelector(".line-total");

            const unitPrice =
                Number(item.dataset.unitPrice || 0);

            const quantity =
                Number(quantityInput?.value || 0);

            const lineTotal =
                unitPrice * quantity;

            item.dataset.lineTotal =
                lineTotal.toString();

            lineTotalElement.textContent =
                formatMoney(lineTotal);

            updateOrderTotal();
        }

        function clearProductInfo(item) {
            item.dataset.unitPrice = "0";
            item.dataset.lineTotal = "0";
            item.dataset.stock = "0";

            const priceElement =
                item.querySelector(".product-price");

            const stockElement =
                item.querySelector(".product-stock");

            const errorElement =
                item.querySelector(".product-error");

            const lineTotalElement =
                item.querySelector(".line-total");

            const quantityInput =
                item.querySelector(".quantity-input");

            priceElement.textContent = "-";
            stockElement.textContent = "-";
            errorElement.textContent = "";
            lineTotalElement.textContent = "0,00";

            if (quantityInput) {
                quantityInput.removeAttribute("max");
            }

            updateOrderTotal();
        }

        async function loadProductInfo(productSelect) {
            const item =
                productSelect.closest(".order-item");

            const productId =
                Number(productSelect.value);

            const priceElement =
                item.querySelector(".product-price");

            const stockElement =
                item.querySelector(".product-stock");

            const errorElement =
                item.querySelector(".product-error");

            const quantityInput =
                item.querySelector(".quantity-input");

            if (!productId || productId <= 0) {
                clearProductInfo(item);
                return;
            }

            priceElement.textContent = "...";
            stockElement.textContent = "...";
            errorElement.textContent = "";

            try {
                const response = await fetch(
                    `${productInfoUrl}?productId=${encodeURIComponent(productId)}`,
                    {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    }
                );

                if (!response.ok) {
                    throw new Error(
                        "Product information could not be loaded."
                    );
                }

                const product =
                    await response.json();

                const price =
                    Number(product.price ?? 0);

                const stock =
                    Number(product.stock ?? 0);

                item.dataset.unitPrice =
                    price.toString();

                item.dataset.stock =
                    stock.toString();

                priceElement.textContent =
                    formatMoney(price);

                stockElement.textContent =
                    stock.toString();

                if (quantityInput) {
                    quantityInput.max =
                        stock.toString();
                }

                updateLineTotal(item);
            }
            catch (error) {
                clearProductInfo(item);

                errorElement.textContent =
                    error.message;
            }
        }

        function addItem() {
            const clone =
                template.content.cloneNode(true);

            container.appendChild(clone);

            updateIndexes();
            updateOrderTotal();
        }

        addButton.addEventListener(
            "click",
            addItem
        );

        customerSelect.addEventListener(
            "change",
            loadCustomerInfo
        );

        container.addEventListener(
            "change",
            function(event) {
                if (
                    event.target.classList.contains(
                        "product-select"
                    )
                ) {
                    loadProductInfo(event.target);
                }
            }
        );

        container.addEventListener(
            "input",
            function(event) {
                if (
                    event.target.classList.contains(
                        "quantity-input"
                    )
                ) {
                    const item =
                        event.target.closest(".order-item");

                    const stock =
                        Number(item.dataset.stock || 0);

                    const quantity =
                        Number(event.target.value || 0);

                    const errorElement =
                        item.querySelector(".product-error");

                    if (
                        stock > 0 &&
                        quantity > stock
                    ) {
                        errorElement.textContent =
                            `Maximum available stock is ${stock}.`;
                    }
                    else {
                        errorElement.textContent = "";
                    }

                    updateLineTotal(item);
                }
            }
        );

        container.addEventListener(
            "click",
            function(event) {
                if (
                    event.target.classList.contains(
                        "remove-item-button"
                    )
                ) {
                    event.target
                        .closest(".order-item")
                        .remove();

                    updateIndexes();
                    updateOrderTotal();
                }
            }
        );

        updateIndexes();

        if (Number(customerSelect.value) > 0) {
            loadCustomerInfo();
        }

        container
            .querySelectorAll(".product-select")
            .forEach(productSelect => {
                if (Number(productSelect.value) > 0) {
                    loadProductInfo(productSelect);
                }
            });

        updateOrderTotal();
    </script>
}