@model MiniCRM.ViewModels.OrderListViewModel

@{
    ViewData["Title"] =
        Localization.GetText("Orders");

    var orderSearchPlaceholder =
        Localization.GetText("OrderNumber");
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex
        justify-content-between
        align-items-center
        mb-4">

        <div>

            <h2>
                @Localization.GetText("OrderManagement")
            </h2>

            <p class="text-muted mb-0">
                @Localization.GetText("OrderManagementPageDescription")
            </p>

        </div>

        <a asp-controller="Order"
           asp-action="Create"
           class="btn btn-primary">

            @Localization.GetText("CreateNewOrder")

        </a>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <!-- Filters -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                @Localization.GetText("OrderFilters")
            </h5>

        </div>

        <div class="card-body">

            <form asp-controller="Order"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label">
                            @Localization.GetText("OrderSearch")
                        </label>

                        <input type="text"
                               name="search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="@orderSearchPlaceholder" />

                    </div>


                    <!-- Customer -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label">
                            @Localization.GetText("Customer")
                        </label>

                        <select name="customerId"
                                class="form-select">

                            <option value="">
                                @Localization.GetText("AllCustomers")
                            </option>

                            @foreach (var customer in Model.Customers)
                            {
                                if (Model.CustomerId == customer.Id)
                                {
                                    <option value="@customer.Id"
                                            selected>

                                        @customer.Name
                                        @customer.Surname

                                    </option>
                                }
                                else
                                {
                                    <option value="@customer.Id">

                                        @customer.Name
                                        @customer.Surname

                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- Status -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label">
                            @Localization.GetText("Status")
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                @Localization.GetText("AllStatuses")
                            </option>

                            @foreach (
                                var status in
                                Enum.GetValues<
                                    MiniCRM.Models.Order.OrderStatus
                                >()
                            )
                            {
                                var statusText =
                                    status switch
                                    {
                                        MiniCRM.Models.Order.OrderStatus.Draft =>
                                            Localization.GetText("StatusDraft"),

                                        MiniCRM.Models.Order.OrderStatus.Completed =>
                                            Localization.GetText("StatusCompleted"),

                                        MiniCRM.Models.Order.OrderStatus.Cancelled =>
                                            Localization.GetText("StatusCancelled"),

                                        _ => status.ToString()
                                    };

                                if (Model.Status == status)
                                {
                                    <option value="@status"
                                            selected>

                                        @statusText

                                    </option>
                                }
                                else
                                {
                                    <option value="@status">
                                        @statusText
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- Start Date -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label">
                            @Localization.GetText("StartDate")
                        </label>

                        <input type="date"
                               name="startDate"
                               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>


                    <!-- End Date -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label">
                            @Localization.GetText("EndDate")
                        </label>

                        <input type="date"
                               name="endDate"
                               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>


                    <!-- Min Amount -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label">
                            @Localization.GetText("MinAmount")
                        </label>

                        <input type="number"
                               name="minAmount"
                               value="@Model.MinAmount"
                               min="0"
                               step="0.01"
                               class="form-control"
                               placeholder="10000" />

                    </div>


                    <!-- Max Amount -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label">
                            @Localization.GetText("MaxAmount")
                        </label>

                        <input type="number"
                               name="maxAmount"
                               value="@Model.MaxAmount"
                               min="0"
                               step="0.01"
                               class="form-control"
                               placeholder="100000" />

                    </div>


                    <!-- Buttons -->
                    <div class="col-md-6
                        col-lg-3
                        d-flex
                        align-items-end
                        gap-2">

                        <button type="submit"
                                class="btn btn-dark">

                            @Localization.GetText("Filter")

                        </button>

                        <a asp-controller="Order"
                           asp-action="Index"
                           class="btn btn-outline-secondary">

                            @Localization.GetText("Clear")

                        </a>

                    </div>

                </div>

                <input type="hidden"
                       name="pageSize"
                       value="@Model.PageSize" />

            </form>

        </div>

    </div>


    <!-- Result Info -->
    <div class="d-flex
        justify-content-between
        align-items-center
        mb-3">

        <div class="text-muted">

            @Localization.GetText("TotalResults"):

            <strong>
                @Model.TotalCount
            </strong>

        </div>

        @if (Model.TotalPages > 0)
        {
            <div class="text-muted">

                @Localization.GetText("Page")

                <strong>
                    @Model.CurrentPage
                </strong>

                @Localization.GetText("Of")

                <strong>
                    @Model.TotalPages
                </strong>

            </div>
        }

    </div>


    <!-- Orders Table -->
    <div class="card shadow-sm">

        <div class="card-body">

            @if (Model.Orders.Count == 0)
            {
                <div class="alert alert-info mb-0">

                    @Localization.GetText("NoOrdersForFilters")

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table
                        table-hover
                        align-middle">

                        <thead>

                            <tr>

                                <th>
                                    @Localization.GetText("OrderNumber")
                                </th>

                                <th>
                                    @Localization.GetText("CustomerId")
                                </th>

                                <th>
                                    @Localization.GetText("OrderDate")
                                </th>

                                <th>
                                    @Localization.GetText("TotalAmount")
                                </th>

                                <th>
                                    @Localization.GetText("Status")
                                </th>

                                <th class="text-end">
                                    @Localization.GetText("Actions")
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var order in Model.Orders)
                            {
                                <tr>

                                    <td>
                                        #@order.Id
                                    </td>

                                    <td>
                                        @order.CustomerId
                                    </td>

                                    <td>

                                        @order.OrderDate.ToString(
                                            "dd.MM.yyyy HH:mm"
                                        )

                                    </td>

                                    <td>
                                        @order.TotalAmount.ToString("N2") TL
                                    </td>

                                    <td>

                                        @if (
                                            order.Status ==
                                            MiniCRM.Models.Order.OrderStatus.Draft
                                        )
                                        {
                                            <span class="badge
                                                bg-warning
                                                text-dark">

                                                @Localization.GetText("StatusDraft")

                                            </span>
                                        }
                                        else if (
                                            order.Status ==
                                            MiniCRM.Models.Order.OrderStatus.Completed
                                        )
                                        {
                                            <span class="badge bg-success">

                                                @Localization.GetText("StatusCompleted")

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">

                                                @Localization.GetText("StatusCancelled")

                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Details"
                                           asp-route-id="@order.Id"
                                           class="btn btn-sm btn-outline-info">

                                            @Localization.GetText("Details")

                                        </a>

                                        @if (
                                            order.Status ==
                                            MiniCRM.Models.Order.OrderStatus.Draft
                                        )
                                        {
                                            <a asp-action="Update"
                                               asp-route-id="@order.Id"
                                               class="btn btn-sm btn-outline-primary">

                                                @Localization.GetText("Update")

                                            </a>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">

            <ul class="pagination justify-content-center">

                <li class="page-item
                    @(Model.CurrentPage <= 1
                        ? "disabled"
                        : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-customerId="@Model.CustomerId"
                       asp-route-status="@Model.Status"
                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                       asp-route-minAmount="@Model.MinAmount"
                       asp-route-maxAmount="@Model.MaxAmount"
                       asp-route-pageNumber="@(Model.CurrentPage - 1)"
                       asp-route-pageSize="@Model.PageSize">

                        @Localization.GetText("Previous")

                    </a>

                </li>


                @for (
                    int pageNumberItem = 1;
                    pageNumberItem <= Model.TotalPages;
                    pageNumberItem++
                )
                {
                    <li class="page-item
                        @(pageNumberItem == Model.CurrentPage
                            ? "active"
                            : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-customerId="@Model.CustomerId"
                           asp-route-status="@Model.Status"
                           asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                           asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                           asp-route-minAmount="@Model.MinAmount"
                           asp-route-maxAmount="@Model.MaxAmount"
                           asp-route-pageNumber="@pageNumberItem"
                           asp-route-pageSize="@Model.PageSize">

                            @pageNumberItem

                        </a>

                    </li>
                }


                <li class="page-item
                    @(Model.CurrentPage >= Model.TotalPages
                        ? "disabled"
                        : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-customerId="@Model.CustomerId"
                       asp-route-status="@Model.Status"
                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                       asp-route-minAmount="@Model.MinAmount"
                       asp-route-maxAmount="@Model.MaxAmount"
                       asp-route-pageNumber="@(Model.CurrentPage + 1)"
                       asp-route-pageSize="@Model.PageSize">

                        @Localization.GetText("Next")

                    </a>

                </li>

            </ul>

        </nav>
    }

</div>