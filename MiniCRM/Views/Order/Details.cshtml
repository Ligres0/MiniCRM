@model MiniCRM.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="d-flex justify-content-between
        align-items-center mb-4">

        <div>
            <h2>Order #@Model.Order.Id</h2>
            <p class="text-muted mb-0">
                Order details and purchased products.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Orders
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            Order Information
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <strong>Customer</strong>
                    <div>@Model.CustomerName</div>
                </div>

                <div class="col-md-4">
                    <strong>Order Date</strong>
                    <div>
                        @Model.Order.OrderDate.ToString(
                            "dd.MM.yyyy HH:mm")
                    </div>
                </div>

                <div class="col-md-4">
                    <strong>Status</strong>
                    <div>@Model.Order.Status</div>
                </div>

                <div class="col-md-4">
                    <strong>Created By User ID</strong>
                    <div>@Model.Order.CreatedByUserId</div>
                </div>

                <div class="col-md-4">
                    <strong>Total Amount</strong>
                    <div>
                        @Model.Order.TotalAmount.ToString("N2") TL
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            Products
        </div>

        <div class="card-body">
            @if (Model.Items.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No products exist in this order.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Line Total</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        @item.ProductName
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>
                                        @item.UnitPrice.ToString("N2") TL
                                    </td>

                                    <td>
                                        @item.TotalPrice.ToString("N2") TL
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (Model.Order.Status ==
        MiniCRM.Models.Order.OrderStatus.Draft)
    {
        <div class="d-flex gap-2">
            <a asp-action="Update"
               asp-route-id="@Model.Order.Id"
               class="btn btn-primary">
                Update Order
            </a>

            <form asp-action="Complete"
                  asp-route-id="@Model.Order.Id"
                  method="post">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-success"
                        onclick="return confirm(
                    'Complete this order?');">
                    Complete
                </button>
            </form>

            <form asp-controller="Order"
                  asp-action="Cancel"
                  asp-route-id="@Model.Order.Id"
                  method="post">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger">
                    Cancel Order
                </button>
            </form>
        </div>
    }
</div>