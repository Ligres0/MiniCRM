@model MiniCRM.ViewModels.CustomerListViewModel
@inject MiniCRM.Services.IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = Localization.GetText("CustomerManagement");

    var searchPlaceholder =
        Localization.GetText("CustomerSearchPlaceholder");

    var companyPlaceholder =
        Localization.GetText("CompanySearchPlaceholder");

    var deactivateMessage =
        Localization.GetText("ConfirmDeactivateCustomer");

    int? userId = Context.Session.GetInt32("UserId");

    bool canCreate =
        userId.HasValue &&
        AuthorizationService.HasPermission(
            userId.Value,
            "Customer.Create");

    bool canEdit =
        userId.HasValue &&
        AuthorizationService.HasPermission(
            userId.Value,
            "Customer.Edit");

    bool canDelete =
        userId.HasValue &&
        AuthorizationService.HasPermission(
            userId.Value,
            "Customer.Delete");
}

<style>
    .customer-page {
        --crm-primary: #4f46e5;
        --crm-secondary: #7c3aed;
        --crm-border: #e5e7eb;
        --crm-muted: #6b7280;
    }

    .customer-header {
        background: linear-gradient(135deg, var(--crm-primary), var(--crm-secondary));
        border-radius: 18px;
        padding: 28px;
        color: white;
        box-shadow: 0 12px 30px rgba(79, 70, 229, 0.20);
    }

    .filter-card,
    .customer-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.08);
    }

    .customer-table thead th {
        background-color: #f8fafc;
        color: #475569;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 1px solid var(--crm-border);
        white-space: nowrap;
    }

    .customer-table tbody tr {
        transition: background-color 0.2s ease;
    }

        .customer-table tbody tr:hover {
            background-color: #f8fafc;
        }

    .customer-avatar {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #eef2ff;
        color: var(--crm-primary);
        font-weight: 700;
        flex-shrink: 0;
    }

    .customer-name {
        font-weight: 600;
        color: #0f172a;
    }

    .customer-secondary {
        color: var(--crm-muted);
        font-size: 0.88rem;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 11px;
        font-size: 0.82rem;
        font-weight: 600;
    }

    .status-active {
        color: #166534;
        background: #dcfce7;
    }

    .status-passive {
        color: #991b1b;
        background: #fee2e2;
    }

    .action-button {
        border-radius: 10px;
        white-space: nowrap;
    }

    .pagination .page-link {
        border-radius: 10px;
        margin: 0 3px;
        color: var(--crm-primary);
        border-color: var(--crm-border);
    }

    .pagination .page-item.active .page-link {
        background-color: var(--crm-primary);
        border-color: var(--crm-primary);
        color: white;
    }

    .empty-state {
        padding: 55px 20px;
        text-align: center;
        color: var(--crm-muted);
    }
</style>

<div class="container-fluid py-4 customer-page">

    <!-- Header -->
    <div class="customer-header mb-4">

        <div class="d-flex flex-column
            flex-lg-row
            align-items-lg-center
            justify-content-between
            gap-3">

            <div>

                <h1 class="h3 fw-bold mb-2">
                    @Localization.GetText("CustomerManagement")
                </h1>

                <p class="mb-0 opacity-75">
                    @Localization.GetText("CustomerManagementPageDescription")
                </p>

            </div>

            @if (canCreate)
            {
                <div>

                    <a asp-controller="Customer"
                       asp-action="Create"
                       class="btn btn-light fw-semibold px-4 py-2">

                        + @Localization.GetText("NewCustomer")

                    </a>

                </div>
            }

        </div>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- Filters -->
    <div class="card filter-card mb-4">

        <div class="card-body p-4">

            <form asp-controller="Customer"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-12 col-md-4">

                        <label asp-for="Search"
                               class="form-label fw-semibold">

                            @Localization.GetText("SearchCustomer")

                        </label>

                        <input asp-for="Search"
                               class="form-control"
                               placeholder="@searchPlaceholder" />

                    </div>

                    <div class="col-12 col-md-3">

                        <label asp-for="CompanyName"
                               class="form-label fw-semibold">

                            @Localization.GetText("CompanyName")

                        </label>

                        <input asp-for="CompanyName"
                               class="form-control"
                               placeholder="@companyPlaceholder" />

                    </div>

                    <div class="col-12 col-md-2">

                        <label asp-for="IsActive"
                               class="form-label fw-semibold">

                            @Localization.GetText("Status")

                        </label>

                        <select asp-for="IsActive"
                                class="form-select">

                            <option value="">
                                @Localization.GetText("All")
                            </option>

                            <option value="true">
                                @Localization.GetText("Active")
                            </option>

                            <option value="false">
                                @Localization.GetText("Passive")
                            </option>

                        </select>

                    </div>

                    <div class="col-12 col-md-3">

                        <div class="d-grid d-md-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-grow-1">

                                @Localization.GetText("Filter")

                            </button>

                            <a asp-controller="Customer"
                               asp-action="Index"
                               class="btn btn-outline-secondary flex-grow-1">

                                @Localization.GetText("Clear")

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Customer list -->
    <div class="card customer-card">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex flex-column
                flex-md-row
                justify-content-between
                gap-2">

                <div>

                    <h2 class="h5 fw-bold mb-1">
                        @Localization.GetText("CustomerList")
                    </h2>

                    <span class="text-secondary">

                        @Localization.GetText("TotalMatchingCustomers")

                        <strong>
                            @Model.TotalCount
                        </strong>

                    </span>

                </div>

                @if (Model.TotalPages > 0)
                {
                    <div class="text-secondary">

                        @Localization.GetText("Page")

                        <strong>@Model.CurrentPage</strong>

                        /

                        <strong>@Model.TotalPages</strong>

                    </div>
                }

            </div>

        </div>

        <div class="card-body p-0">

            @if (Model.Customers != null &&
                 Model.Customers.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table customer-table align-middle mb-0">

                        <thead>

                            <tr>

                                <th class="ps-4">
                                    @Localization.GetText("Customer")
                                </th>

                                <th>
                                    @Localization.GetText("Contact")
                                </th>

                                <th>
                                    @Localization.GetText("Company")
                                </th>

                                <th>
                                    @Localization.GetText("CreatedDate")
                                </th>

                                <th>
                                    @Localization.GetText("Status")
                                </th>

                                <th class="text-end pe-4">
                                    @Localization.GetText("Actions")
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var customer in Model.Customers)
                            {
                                string firstLetter =
                                    string.IsNullOrWhiteSpace(customer.Name)
                                        ? "?"
                                        : customer.Name
                                            .Substring(0, 1)
                                            .ToUpper();

                                <tr>

                                    <td class="ps-4">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="customer-avatar">
                                                @firstLetter
                                            </div>

                                            <div>

                                                <div class="customer-name">
                                                    @customer.Name @customer.Surname
                                                </div>

                                                <div class="customer-secondary">

                                                    @Localization.GetText("CustomerNumber"):
                                                    #@customer.Id

                                                </div>

                                            </div>

                                        </div>

                                    </td>

                                    <td>

                                        <div>

                                            @(string.IsNullOrWhiteSpace(customer.Email)
                                                ? Localization.GetText("NoEmailFound")
                                                : customer.Email)

                                        </div>

                                        <div class="customer-secondary">

                                            @(string.IsNullOrWhiteSpace(customer.Phone)
                                                ? Localization.GetText("NoPhoneFound")
                                                : customer.Phone)

                                        </div>

                                    </td>

                                    <td>

                                        @(string.IsNullOrWhiteSpace(customer.CompanyName)
                                            ? "-"
                                            : customer.CompanyName)

                                    </td>

                                    <td>
                                        @customer.CreatedDate.ToString("dd.MM.yyyy")
                                    </td>

                                    <td>

                                        @if (customer.IsActive)
                                        {
                                            <span class="status-badge status-active">

                                                ● @Localization.GetText("Active")

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-passive">

                                                ● @Localization.GetText("Passive")

                                            </span>
                                        }

                                    </td>

                                    <td class="text-end pe-4">

                                        <div class="d-inline-flex
                                            flex-wrap
                                            justify-content-end
                                            gap-2">

                                            <a asp-controller="Customer"
                                               asp-action="Details"
                                               asp-route-id="@customer.Id"
                                               class="btn btn-sm
                                                btn-outline-info
                                                action-button">

                                                @Localization.GetText("Details")

                                            </a>
                                           
@if (canEdit)
{
    <a asp-controller="Customer"
       asp-action="Update"
       asp-route-id="@customer.Id"
       class="btn btn-sm
        btn-outline-primary
        action-button">

        @Localization.GetText("Edit")

    </a>
}

@if (canDelete && customer.IsActive)
{
    <form asp-controller="Customer"
          asp-action="Deactivate"
          asp-route-id="@customer.Id"
          method="post"
          class="d-inline">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="btn btn-sm
                btn-outline-danger
                action-button"
                onclick="return confirm('@deactivateMessage');">

            @Localization.GetText("Deactivate")

        </button>

    </form>
}

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="display-5 mb-3">
                        ☷
                    </div>

                    <h3 class="h5 fw-bold text-dark">
                        @Localization.GetText("NoCustomersFound")
                    </h3>

                    <p class="mb-3">
                        @Localization.GetText("NoCustomersDescription")
                    </p>

                    <a asp-controller="Customer"
                       asp-action="Index"
                       class="btn btn-outline-primary">

                        @Localization.GetText("ClearFilters")

                    </a>

                </div>
            }

        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 p-4">

                <nav>

                    <ul class="pagination
                        justify-content-center
                        flex-wrap
                        mb-0">

                        <li class="page-item
                            @(Model.CurrentPage == 1
                                ? "disabled"
                                : "")">

                            <a class="page-link"
                               asp-controller="Customer"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-search="@Model.Search"
                               asp-route-companyName="@Model.CompanyName"
                               asp-route-isActive="@Model.IsActive">

                                @Localization.GetText("Previous")

                            </a>

                        </li>

                        @for (int pageNumber = 1;
                              pageNumber <= Model.TotalPages;
                              pageNumber++)
                        {
                            <li class="page-item
                                @(pageNumber == Model.CurrentPage
                                    ? "active"
                                    : "")">

                                <a class="page-link"
                                   asp-controller="Customer"
                                   asp-action="Index"
                                   asp-route-page="@pageNumber"
                                   asp-route-search="@Model.Search"
                                   asp-route-companyName="@Model.CompanyName"
                                   asp-route-isActive="@Model.IsActive">

                                    @pageNumber

                                </a>

                            </li>
                        }

                        <li class="page-item
                            @(Model.CurrentPage == Model.TotalPages
                                ? "disabled"
                                : "")">

                            <a class="page-link"
                               asp-controller="Customer"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-search="@Model.Search"
                               asp-route-companyName="@Model.CompanyName"
                               asp-route-isActive="@Model.IsActive">

                                @Localization.GetText("Next")

                            </a>

                        </li>

                    </ul>

                </nav>

            </div>
        }

    </div>

</div>