@model MiniCRM.Models.Category

@{
    ViewData["Title"] = Localization.GetText("CreateCategory");

    var categoryNamePlaceholder =
        Localization.GetText("EnterCategoryName");
}

<div class="container py-4">

    <div class="mx-auto" style="max-width: 700px;">

        <div class="mb-4">

            <h1 class="fw-bold">
                @Localization.GetText("CreateCategory")
            </h1>

            <p class="text-muted">
                @Localization.GetText("EnterCategoryInformation")
            </p>

        </div>

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4">

                <form asp-controller="Category"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">

                        <label asp-for="Name"
                               class="form-label fw-semibold">

                            @Localization.GetText("CategoryName")

                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="@categoryNamePlaceholder" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="form-check form-switch mb-4">

                        <input asp-for="IsActive"
                               class="form-check-input" />

                        <label asp-for="IsActive"
                               class="form-check-label">

                            @Localization.GetText("Active")

                        </label>

                    </div>

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-controller="Category"
                           asp-action="Index"
                           class="btn btn-outline-secondary">

                            @Localization.GetText("Cancel")

                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            @Localization.GetText("SaveCategory")

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}