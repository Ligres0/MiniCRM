@model MiniCRM.ViewModels.ProductListViewModel
@inject MiniCRM.Services.IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = Localization.GetText("Products");

    var productSearchPlaceholder =
        Localization.GetText("ProductSearchPlaceholder");

    var deactivateMessage =
        Localization.GetText("ConfirmDeactivateProduct");

    int? userId = Context.Session.GetInt32("UserId");

    bool canCreate =
        userId.HasValue &&
        AuthorizationService.HasPermission(
            userId.Value,
            "Product.Create");

    bool canEdit =
        userId.HasValue &&
        AuthorizationService.HasPermission(
            userId.Value,
            "Product.Edit");

    bool canDelete =
        userId.HasValue &&
        AuthorizationService.HasPermission(
            userId.Value,
            "Product.Delete");
}

<style>

    .product-page {
        --crm-primary: #4f46e5;
        --crm-secondary: #7c3aed;
        --crm-dark: #0f172a;
        --crm-muted: #64748b;
        --crm-border: #e2e8f0;
        --crm-background: #f8fafc;
    }


    /* Header */

    .product-header {
        position: relative;
        overflow: hidden;
        padding: 28px;
        border-radius: 20px;
        color: white;
        background: linear-gradient( 135deg, var(--crm-primary), var(--crm-secondary) );
        box-shadow: 0 12px 30px rgba(79, 70, 229, 0.20);
    }

        .product-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            top: -80px;
            right: -45px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.09);
        }

    .product-header-content {
        position: relative;
        z-index: 2;
    }


    /* Cards */

    .filter-card,
    .product-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.08);
    }


    /* Inputs */

    .product-page .form-control,
    .product-page .form-select {
        min-height: 42px;
        border-radius: 10px;
        border-color: var(--crm-border);
    }

        .product-page .form-control:focus,
        .product-page .form-select:focus {
            border-color: var(--crm-primary);
            box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.12);
        }


    /* Table */

    .product-table thead th {
        padding-top: 14px;
        padding-bottom: 14px;
        color: #475569;
        background: #f8fafc;
        border-bottom: 1px solid var(--crm-border);
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .product-table tbody td {
        padding-top: 15px;
        padding-bottom: 15px;
        vertical-align: middle;
        border-color: #f1f5f9;
    }

    .product-table tbody tr {
        transition: background-color 0.2s ease;
    }

        .product-table tbody tr:hover {
            background-color: #f8fafc;
        }


    /* Product */

    .product-avatar {
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 13px;
        color: var(--crm-primary);
        background: #eef2ff;
        font-size: 1rem;
        font-weight: 800;
    }

    .product-name {
        color: var(--crm-dark);
        font-weight: 700;
    }

    .product-secondary {
        margin-top: 2px;
        color: var(--crm-muted);
        font-size: 0.85rem;
    }


    /* Category */

    .category-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        border-radius: 999px;
        color: #4338ca;
        background: #eef2ff;
        font-size: 0.82rem;
        font-weight: 650;
    }


    /* Price */

    .price-text {
        color: var(--crm-dark);
        font-weight: 700;
        white-space: nowrap;
    }


    /* Stock */

    .stock-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 6px 11px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 650;
        white-space: nowrap;
    }

    .stock-normal {
        color: #166534;
        background: #dcfce7;
    }

    .stock-critical {
        color: #92400e;
        background: #fef3c7;
    }

    .stock-empty {
        color: #991b1b;
        background: #fee2e2;
    }


    /* Status */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 11px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 650;
        white-space: nowrap;
    }

    .status-active {
        color: #166534;
        background: #dcfce7;
    }

    .status-passive {
        color: #991b1b;
        background: #fee2e2;
    }


    /* Actions */

    .action-button {
        border-radius: 9px;
        white-space: nowrap;
    }


    /* Pagination */

    .pagination .page-link {
        margin: 0 3px;
        border-radius: 10px;
        color: var(--crm-primary);
        border-color: var(--crm-border);
    }

    .pagination
    .page-item.active
    .page-link {
        color: white;
        background-color: var(--crm-primary);
        border-color: var(--crm-primary);
    }


    /* Empty */

    .empty-state {
        padding: 55px 20px;
        text-align: center;
        color: var(--crm-muted);
    }

    .empty-state-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 60px;
        height: 60px;
        margin: 0 auto 16px;
        border-radius: 18px;
        color: var(--crm-primary);
        background: #eef2ff;
        font-size: 1.5rem;
        font-weight: 800;
    }


    @@media (max-width: 767px) {

        .product-header {
            padding: 24px 20px;
        }
    }

</style>


<div class="container-fluid py-4 product-page">


    <!-- Header -->

    <div class="product-header mb-4">

        <div class="product-header-content">

            <div class="d-flex
                flex-column
                flex-lg-row
                align-items-lg-center
                justify-content-between
                gap-3">

                <div>

                    <h1 class="h3 fw-bold mb-2">

                        @Localization.GetText("Products")

                    </h1>

                    <p class="mb-0 opacity-75">

                        @Localization.GetText(
                            "ProductManagementPageDescription"
                        )

                    </p>

                </div>


                @if (canCreate)
                {
                    <div>

                        <a asp-controller="Product"
                           asp-action="Create"
                           class="btn
                            btn-light
                            fw-semibold
                            px-4
                            py-2">

                            + @Localization.GetText(
                                                            "NewProduct"
                                                        )

                        </a>

                    </div>
                }

            </div>

        </div>

    </div>



    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert
            alert-success
            alert-dismissible
            fade
            show
            shadow-sm"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert
            alert-danger
            alert-dismissible
            fade
            show
            shadow-sm"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }



    <!-- Filters -->

    <div class="card filter-card mb-4">

        <div class="card-body p-4">

            <form asp-controller="Product"
                  asp-action="Index"
                  method="get">

                <div class="row
                    g-3
                    align-items-end">


                    <!-- Search -->

                    <div class="col-12 col-md-4">

                        <label asp-for="Search"
                               class="form-label
                            fw-semibold">

                            @Localization.GetText(
                                "ProductSearch"
                            )

                        </label>

                        <input asp-for="Search"
                               class="form-control"
                               placeholder="@productSearchPlaceholder" />

                    </div>



                    <!-- Category -->

                    <div class="col-12 col-md-3">

                        <label asp-for="CategoryId"
                               class="form-label
                            fw-semibold">

                            @Localization.GetText(
                                "Category"
                            )

                        </label>

                        <select asp-for="CategoryId"
                                class="form-select">

                            <option value="">

                                @Localization.GetText(
                                    "AllCategories"
                                )

                            </option>


                            @foreach (
                                var category
                                in Model.Categories)
                            {
                                <option value="@category.Id">

                                    @category.Name

                                </option>
                            }

                        </select>

                    </div>



                    <!-- Status -->

                    <div class="col-12 col-md-2">

                        <label asp-for="IsActive"
                               class="form-label
                            fw-semibold">

                            @Localization.GetText(
                                "Status"
                            )

                        </label>

                        <select asp-for="IsActive"
                                class="form-select">

                            <option value="">

                                @Localization.GetText(
                                    "All"
                                )

                            </option>

                            <option value="true">

                                @Localization.GetText(
                                    "Active"
                                )

                            </option>

                            <option value="false">

                                @Localization.GetText(
                                    "Inactive"
                                )

                            </option>

                        </select>

                    </div>



                    <!-- Buttons -->

                    <div class="col-12 col-md-3">

                        <div class="d-grid
                            d-md-flex
                            gap-2">

                            <button type="submit"
                                    class="btn
                                btn-primary
                                flex-grow-1">

                                @Localization.GetText(
                                    "Filter"
                                )

                            </button>


                            <a asp-controller="Product"
                               asp-action="Index"
                               class="btn
                                btn-outline-secondary
                                flex-grow-1">

                                @Localization.GetText(
                                    "Clear"
                                )

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>



    <!-- Product List -->

    <div class="card product-card">

        <div class="card-header
            bg-white
            border-0
            p-4">

            <div class="d-flex
                flex-column
                flex-md-row
                justify-content-between
                align-items-md-center
                gap-2">

                <div>

                    <h2 class="h5 fw-bold mb-1">

                        @Localization.GetText(
                            "ProductList"
                        )

                    </h2>

                    <span class="text-secondary">

                        @Localization.GetText(
                            "TotalProducts"
                        ):

                        <strong>
                            @Model.TotalCount
                        </strong>

                    </span>

                </div>


                @if (Model.TotalPages > 0)
                {
                    <div class="text-secondary">

                        @Localization.GetText(
                            "Page"
                        )

                        <strong>
                            @Model.CurrentPage
                        </strong>

                        /

                        <strong>
                            @Model.TotalPages
                        </strong>

                    </div>
                }

            </div>

        </div>



        <div class="card-body p-0">

            @if (Model.Products != null &&
                 Model.Products.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table
                        product-table
                        align-middle
                        mb-0">

                        <thead>

                            <tr>

                                <th class="ps-4">

                                    @Localization.GetText(
                                        "Product"
                                    )

                                </th>

                                <th>

                                    @Localization.GetText(
                                        "Category"
                                    )

                                </th>

                                <th>

                                    @Localization.GetText(
                                        "Price"
                                    )

                                </th>

                                <th>

                                    @Localization.GetText(
                                        "Stock"
                                    )

                                </th>

                                <th>

                                    @Localization.GetText(
                                        "Status"
                                    )

                                </th>

                                <th>

                                    @Localization.GetText(
                                        "CreatedDate"
                                    )

                                </th>

                                <th class="text-end pe-4">

                                    @Localization.GetText(
                                        "Actions"
                                    )

                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (
                                var product
                                in Model.Products)
                            {
                                string firstLetter =
                                    string.IsNullOrWhiteSpace(
                                        product.Name)
                                        ? "?"
                                        : product.Name
                                            .Substring(0, 1)
                                            .ToUpper();


                                <tr>


                                    <!-- Product -->

                                    <td class="ps-4">

                                        <div class="d-flex
                                            align-items-center
                                            gap-3">

                                            <div class="product-avatar">

                                                @firstLetter

                                            </div>


                                            <div>

                                                <div class="product-name">

                                                    @product.Name

                                                </div>

                                                <div class="product-secondary">

                                                    @Localization.GetText(
                                                        "ProductNumber"
                                                    ):
                                                    #@product.Id

                                                </div>

                                            </div>

                                        </div>

                                    </td>



                                    <!-- Category -->

                                    <td>

                                        @if (
                                            string.IsNullOrWhiteSpace(
                                                product.CategoryName))
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="category-badge">

                                                @product.CategoryName

                                            </span>
                                        }

                                    </td>



                                    <!-- Price -->

                                    <td>

                                        <span class="price-text">

                                            @product.Price.ToString("N2")
                                            ₺

                                        </span>

                                    </td>



                                    <!-- Stock -->

                                    <td>

                                        @if (product.Stock == 0)
                                        {
                                            <span class="stock-badge
                                                stock-empty">

                                                @Localization.GetText(
                                                    "OutOfStock"
                                                )

                                            </span>
                                        }
                                        else if (product.Stock <= 5)
                                        {
                                            <span class="stock-badge
                                                stock-critical">

                                                @Localization.GetText(
                                                    "Critical"
                                                ):
                                                @product.Stock

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="stock-badge
                                                stock-normal">

                                                @product.Stock

                                                @Localization.GetText(
                                                    "UnitsInStock"
                                                )

                                            </span>
                                        }

                                    </td>



                                    <!-- Status -->

                                    <td>

                                        @if (product.IsActive)
                                        {
                                            <span class="status-badge
                                                status-active">

                                                ●

                                                @Localization.GetText(
                                                    "Active"
                                                )

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge
                                                status-passive">

                                                ●

                                                @Localization.GetText(
                                                    "Inactive"
                                                )

                                            </span>
                                        }

                                    </td>



                                    <!-- Created Date -->

                                    <td>

                                        <span class="text-secondary">
                                            @product.CreatedDate.ToString("dd/MM/yyyy")
                                        </span>

                                    </td>



                                    <!-- Actions -->

                                    <td class="text-end pe-4">

                                        <div class="d-inline-flex
                                            flex-wrap
                                            justify-content-end
                                            gap-2">


                                            <!-- Details -->

                                            <a asp-controller="Product"
                                               asp-action="Details"
                                               asp-route-id="@product.Id"
                                               class="btn
                                                btn-sm
                                                btn-outline-info
                                                action-button">

                                                @Localization.GetText(
                                                    "Details"
                                                )

                                            </a>



                                            <!-- Edit -->
                                            @if (canEdit)
                                            {
                                                <a asp-controller="Product"
                                                   asp-action="Update"
                                                   asp-route-id="@product.Id"
                                                   class="btn
                                                    btn-sm
                                                    btn-outline-primary
                                                    action-button">

                                                    @Localization.GetText(
                                                        "Edit"
                                                    )

                                                </a>
                                            }



                                            <!-- Deactivate -->
                                            @if (
                                                                                            canDelete &&
                                                                                            product.IsActive)
                                            {
                                                <form asp-controller="Product"
                                                      asp-action="Deactivate"
                                                      asp-route-id="@product.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn
                                                        btn-sm
                                                        btn-outline-danger
                                                        action-button"
                                                            onclick="return confirm('@deactivateMessage');">

                                                        @Localization.GetText(
                                                            "Deactivate"
                                                        )

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {

                <!-- Empty State -->

                <div class="empty-state">

                    <div class="empty-state-icon">

                        Ü

                    </div>

                    <h3 class="h5
                        fw-bold
                        text-dark">

                        @Localization.GetText(
                            "NoProductsFound"
                        )

                    </h3>

                    <p class="mb-3">

                        @Localization.GetText(
                            "NoProductsDescription"
                        )

                    </p>


                    @if (canCreate)
                    {
                        <a asp-controller="Product"
                           asp-action="Create"
                           class="btn btn-primary">

                            + @Localization.GetText(
                                                            "CreateProduct"
                                                        )

                        </a>
                    }

                </div>
            }

        </div>



        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer
                bg-white
                border-0
                p-4">

                <nav>

                    <ul class="pagination
                        justify-content-center
                        flex-wrap
                        mb-0">


                        <!-- Previous -->

                        <li class="page-item
                            @(Model.CurrentPage == 1
                                ? "disabled"
                                : "")">

                            <a class="page-link"
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-pageNumber="@(Model.CurrentPage - 1)"
                               asp-route-search="@Model.Search"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-isActive="@Model.IsActive">

                                @Localization.GetText(
                                    "Previous"
                                )

                            </a>

                        </li>



                        <!-- Pages -->
                        @for (
                                                    int pageNumber = 1;
                                                    pageNumber <= Model.TotalPages;
                                                    pageNumber++)
                        {
                            <li class="page-item
                                @(pageNumber == Model.CurrentPage
                                    ? "active"
                                    : "")">

                                <a class="page-link"
                                   asp-controller="Product"
                                   asp-action="Index"
                                   asp-route-pageNumber="@pageNumber"
                                   asp-route-search="@Model.Search"
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-isActive="@Model.IsActive">

                                    @pageNumber

                                </a>

                            </li>
                        }



                        <!-- Next -->

                        <li class="page-item
                            @(Model.CurrentPage == Model.TotalPages
                                ? "disabled"
                                : "")">

                            <a class="page-link"
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-pageNumber="@(Model.CurrentPage + 1)"
                               asp-route-search="@Model.Search"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-isActive="@Model.IsActive">

                                @Localization.GetText(
                                    "Next"
                                )

                            </a>

                        </li>

                    </ul>

                </nav>

            </div>
        }

    </div>

</div>