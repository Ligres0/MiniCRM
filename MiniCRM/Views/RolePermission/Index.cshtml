@model List<MiniCRM.Models.Role>

@{
    ViewData["Title"] = "Rol Yetkileri";
}

<div class="container py-4">

    <div class="p-4 mb-4 text-white rounded-4"
         style="background: linear-gradient(135deg, #4f46e5, #7c3aed);">

        <span class="badge bg-light text-primary mb-2">
            Yönetim Paneli
        </span>

        <h2 class="fw-bold mb-1">
            Rol Yetkileri
        </h2>

        <p class="mb-0 opacity-75">
            Roller için sistem permissionlarını yönetin.
        </p>

    </div>


    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-1">
                Roller
            </h5>

            <p class="text-muted mb-4">
                Yetkilerini değiştirmek istediğiniz rolü seçin.
            </p>


            @foreach (var role in Model)
            {
                <div class="d-flex
                    justify-content-between
                    align-items-center
                    border
                    rounded-3
                    p-3
                    mb-3">

                    <div>

                        <div class="fw-bold">
                            @role.Name
                        </div>

                        <small class="text-muted">
                            Rol #@role.Id
                        </small>

                    </div>


                    <a asp-controller="RolePermission"
                       asp-action="Edit"
                       asp-route-id="@role.Id"
                       class="btn btn-outline-primary">

                        Yetkileri Yönet

                    </a>

                </div>
            }


            <a asp-controller="User"
               asp-action="Index"
               class="btn btn-outline-secondary mt-2">

                Kullanıcı Yönetimine Dön

            </a>

        </div>

    </div>

</div>