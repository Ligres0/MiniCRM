@model MiniCRM.ViewModels.ProductFormViewModel

@{
    ViewData["Title"] = Localization.GetText("CreateProduct");

    var productNamePlaceholder =
        Localization.GetText("EnterProductName");
}

<style>

    .product-form-page {
        --crm-primary: #4f46e5;
        --crm-secondary: #7c3aed;
        --crm-dark: #0f172a;
        --crm-muted: #64748b;
        --crm-border: #e2e8f0;
    }

    .product-form-header {
        position: relative;
        overflow: hidden;
        padding: 28px;
        border-radius: 20px;
        color: white;
        background: linear-gradient( 135deg, var(--crm-primary), var(--crm-secondary) );
        box-shadow: 0 12px 30px rgba(79, 70, 229, 0.20);
    }

        .product-form-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            top: -85px;
            right: -45px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.09);
        }

    .product-form-header-content {
        position: relative;
        z-index: 2;
    }

    .product-form-card {
        border: 0;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.08);
    }

    .form-section-title {
        color: var(--crm-dark);
        font-size: 1rem;
        font-weight: 700;
    }

    .form-section-description {
        color: var(--crm-muted);
        font-size: 0.88rem;
    }

    .product-form-page .form-control,
    .product-form-page .form-select {
        min-height: 46px;
        border-radius: 11px;
        border-color: var(--crm-border);
    }

        .product-form-page .form-control:focus,
        .product-form-page .form-select:focus {
            border-color: var(--crm-primary);
            box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.12);
        }

    .field-card {
        height: 100%;
        padding: 18px;
        border: 1px solid var(--crm-border);
        border-radius: 15px;
        background: #ffffff;
    }

    .active-box {
        padding: 18px;
        border-radius: 15px;
        background: #f8fafc;
        border: 1px solid var(--crm-border);
    }

    .form-actions {
        padding-top: 20px;
        border-top: 1px solid var(--crm-border);
    }

    .form-action-button {
        min-width: 130px;
        border-radius: 10px;
    }

</style>


<div class="container-fluid py-4 product-form-page">

    <div class="mx-auto"
         style="max-width: 900px;">


        <!-- Header -->

        <div class="product-form-header mb-4">

            <div class="product-form-header-content">

                <h1 class="h3 fw-bold mb-2">
                    @Localization.GetText("CreateProduct")
                </h1>

                <p class="mb-0 opacity-75">
                    @Localization.GetText("EnterProductInformation")
                </p>

            </div>

        </div>


        <!-- Form -->

        <div class="card product-form-card">

            <div class="card-body p-4 p-lg-5">

                <div class="mb-4">

                    <div class="form-section-title">
                        @Localization.GetText("Product")
                    </div>

                    <div class="form-section-description">
                        @Localization.GetText("EnterProductInformation")
                    </div>

                </div>


                <form asp-controller="Product"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()


                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>


                    <div class="row g-4">


                        <!-- Product Name -->

                        <div class="col-12 col-md-6">

                            <div class="field-card">

                                <label asp-for="Name"
                                       class="form-label fw-semibold">

                                    @Localization.GetText("ProductName")

                                </label>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="@productNamePlaceholder" />

                                <span asp-validation-for="Name"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>


                        <!-- Category -->

                        <div class="col-12 col-md-6">

                            <div class="field-card">

                                <label asp-for="CategoryId"
                                       class="form-label fw-semibold">

                                    @Localization.GetText("Category")

                                </label>

                                <select asp-for="CategoryId"
                                        class="form-select">

                                    <option value="0">

                                        @Localization.GetText("SelectCategory")

                                    </option>

                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category.Id">
                                            @category.Name
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>


                        <!-- Price -->

                        <div class="col-12 col-md-6">

                            <div class="field-card">

                                <label asp-for="Price"
                                       class="form-label fw-semibold">

                                    @Localization.GetText("Price")

                                </label>

                                <div class="input-group">

                                    <input asp-for="Price"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control" />

                                    <span class="input-group-text">
                                        ₺
                                    </span>

                                </div>

                                <span asp-validation-for="Price"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>


                        <!-- Stock -->

                        <div class="col-12 col-md-6">

                            <div class="field-card">

                                <label asp-for="Stock"
                                       class="form-label fw-semibold">

                                    @Localization.GetText("Stock")

                                </label>

                                <input asp-for="Stock"
                                       type="number"
                                       min="0"
                                       class="form-control" />

                                <span asp-validation-for="Stock"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>


                        <!-- Active -->

                        <div class="col-12">

                            <div class="active-box">

                                <div class="form-check form-switch">

                                    <input asp-for="IsActive"
                                           class="form-check-input" />

                                    <label asp-for="IsActive"
                                           class="form-check-label fw-semibold">

                                        @Localization.GetText("ProductIsActive")

                                    </label>

                                </div>

                            </div>

                        </div>


                        <!-- Buttons -->

                        <div class="col-12">

                            <div class="form-actions
                                d-flex
                                flex-column
                                flex-sm-row
                                justify-content-end
                                gap-2">

                                <a asp-controller="Product"
                                   asp-action="Index"
                                   class="btn
                                    btn-outline-secondary
                                    form-action-button">

                                    @Localization.GetText("Cancel")

                                </a>

                                <button type="submit"
                                        class="btn
                                    btn-primary
                                    form-action-button">

                                    @Localization.GetText("SaveProduct")

                                </button>

                            </div>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}