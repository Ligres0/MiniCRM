@{
    ViewData["Title"] = "Mini CRM";
}

<style>
    .home-page {
        --primary: #4f46e5;
        --secondary: #7c3aed;
        --dark: #0f172a;
        --muted: #64748b;
    }

    .hero-section {
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        border-radius: 24px;
        padding: 60px 45px;
        color: white;
        box-shadow: 0 18px 45px rgba(79, 70, 229, 0.22);
        overflow: hidden;
        position: relative;
    }

        .hero-section::after {
            content: "";
            position: absolute;
            width: 270px;
            height: 270px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.09);
            right: -80px;
            top: -90px;
        }

        .hero-section::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.07);
            right: 160px;
            bottom: -110px;
        }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 780px;
    }

    .hero-title {
        font-size: clamp(2rem, 5vw, 3.6rem);
        font-weight: 800;
        line-height: 1.1;
    }

    .hero-description {
        max-width: 650px;
        font-size: 1.08rem;
        color: rgba(255, 255, 255, 0.82);
    }

    .feature-card {
        border: 0;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.07);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
    }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 38px rgba(15, 23, 42, 0.12);
        }

    .feature-link {
        color: inherit;
        text-decoration: none;
    }

        .feature-link:hover {
            color: inherit;
        }

    .feature-icon {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef2ff;
        color: var(--primary);
        font-size: 1.5rem;
        font-weight: 700;
    }

    .feature-title {
        color: var(--dark);
        font-weight: 700;
    }

    .feature-description {
        color: var(--muted);
        font-size: 0.94rem;
    }

    .module-card {
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        background: white;
        padding: 22px;
        height: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .module-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
        }

    .module-status {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .status-ready {
        background: #dcfce7;
        color: #166534;
    }

    .status-planned {
        background: #f1f5f9;
        color: #475569;
    }
</style>

<div class="container py-5 home-page">

    <section class="hero-section mb-5">
        <div class="hero-content">

            <span class="badge bg-light text-primary mb-3 px-3 py-2">
                Mini CRM / Satış Yönetim Sistemi
            </span>

            <h1 class="hero-title mb-3">
                Müşteri, ürün ve kategori süreçlerini tek yerden yönet
            </h1>

            <p class="hero-description mb-4">
                Müşterileri yönet, ürünleri kategorilere bağla, stok miktarlarını takip et
                ve satış yönetimi için gerekli modüllere hızlıca ulaş.
            </p>

            <div class="d-flex flex-column flex-sm-row flex-wrap gap-3">

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="btn btn-light btn-lg px-4 fw-semibold">
                    Müşteriler
                </a>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-outline-light btn-lg px-4">
                    Ürünler
                </a>

                <a asp-controller="Category"
                   asp-action="Index"
                   class="btn btn-outline-light btn-lg px-4">
                    Kategoriler
                </a>

            </div>
        </div>
    </section>

    <section class="mb-5">

        <div class="text-center mb-4">
            <h2 class="fw-bold">
                Aktif modüller
            </h2>

            <p class="text-secondary">
                İlgili karta tıklayarak yönetim ekranına geçebilirsin.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <a asp-controller="Customer"
                   asp-action="Index"
                   class="feature-link">
                    <div class="card feature-card">
                        <div class="card-body p-4">

                            <div class="feature-icon mb-4">
                                M
                            </div>

                            <h3 class="h5 feature-title">
                                Müşteri Yönetimi
                            </h3>

                            <p class="feature-description mb-0">
                                Müşterileri listele, ara, filtrele, düzenle ve
                                aktif veya pasif durumlarını yönet.
                            </p>

                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-4">
                <a asp-controller="Product"
                   asp-action="Index"
                   class="feature-link">
                    <div class="card feature-card">
                        <div class="card-body p-4">

                            <div class="feature-icon mb-4">
                                Ü
                            </div>

                            <h3 class="h5 feature-title">
                                Ürün Yönetimi
                            </h3>

                            <p class="feature-description mb-0">
                                Ürünleri listele, kategoriye göre filtrele,
                                fiyat ve stok bilgilerini yönet.
                            </p>

                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-4">
                <a asp-controller="Category"
                   asp-action="Index"
                   class="feature-link">
                    <div class="card feature-card">
                        <div class="card-body p-4">

                            <div class="feature-icon mb-4">
                                K
                            </div>

                            <h3 class="h5 feature-title">
                                Kategori Yönetimi
                            </h3>

                            <p class="feature-description mb-0">
                                Kategorileri ekle, düzenle, görüntüle ve
                                ürün formlarında kullanılacak yapıyı yönet.
                            </p>

                        </div>
                    </div>
                </a>
            </div>

        </div>
    </section>

    <section>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-4">

            <div>
                <h2 class="fw-bold mb-1">
                    Uygulama Modülleri
                </h2>

                <p class="text-secondary mb-0">
                    Mini CRM geliştirme durumu
                </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Customer"
                   asp-action="Create"
                   class="btn btn-outline-primary">
                    Yeni Müşteri
                </a>

                <a asp-controller="Product"
                   asp-action="Create"
                   class="btn btn-outline-primary">
                    Yeni Ürün
                </a>

                <a asp-controller="Category"
                   asp-action="Create"
                   class="btn btn-primary">
                    Yeni Kategori
                </a>
            </div>

        </div>

        <div class="row g-3">

            <div class="col-md-6 col-lg-4">
                <div class="module-card d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h3 class="h5 fw-bold mb-0">Müşteriler</h3>

                        <span class="module-status status-ready">
                            Hazır
                        </span>
                    </div>

                    <p class="text-secondary">
                        CRUD, arama, filtreleme, validation ve pagination.
                    </p>

                    <a asp-controller="Customer"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary mt-auto align-self-start">
                        Modülü Aç
                    </a>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="module-card d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h3 class="h5 fw-bold mb-0">Kategoriler</h3>

                        <span class="module-status status-ready">
                            Hazır
                        </span>
                    </div>

                    <p class="text-secondary">
                        Kategori listeleme, ekleme, düzenleme ve pasifleştirme.
                    </p>

                    <a asp-controller="Category"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary mt-auto align-self-start">
                        Modülü Aç
                    </a>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="module-card d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h3 class="h5 fw-bold mb-0">Ürünler</h3>

                        <span class="module-status status-ready">
                            Hazır
                        </span>
                    </div>

                    <p class="text-secondary">
                        Ürün, fiyat, kategori, stok ve aktif/pasif yönetimi.
                    </p>

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary mt-auto align-self-start">
                        Modülü Aç
                    </a>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="module-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h3 class="h5 fw-bold mb-0">Siparişler</h3>

                        <span class="module-status status-planned">
                            Planlandı
                        </span>
                    </div>

                    <p class="text-secondary mb-0">
                        Sipariş oluşturma, detay ve durum yönetimi.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="module-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h3 class="h5 fw-bold mb-0">Kullanıcılar</h3>

                        <span class="module-status status-planned">
                            Planlandı
                        </span>
                    </div>

                    <p class="text-secondary mb-0">
                        Kullanıcı, rol ve yetki yönetimi.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="module-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h3 class="h5 fw-bold mb-0">Dashboard</h3>

                        <span class="module-status status-planned">
                            Planlandı
                        </span>
                    </div>

                    <p class="text-secondary mb-0">
                        Özet istatistikler, son siparişler ve kritik stoklar.
                    </p>
                </div>
            </div>

        </div>
    </section>

</div>
