@model MiniCRM.ViewModels.OrderCreateViewModel

@{
    ViewData["Title"] = "Create Order";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2>Create New Order</h2>
        <p class="text-muted">
            Select a customer and add products to the order.
        </p>
    </div>

    <form asp-controller="Order"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="card mb-4">
            <div class="card-header">
                Customer Information
            </div>

            <div class="card-body">
                <label asp-for="CustomerId"
                       class="form-label">
                    Customer
                </label>

                <select asp-for="CustomerId"
                        class="form-select">
                    <option value="0">
                        Select Customer
                    </option>

                    @foreach (var customer in Model.Customers)
                    {
                        <option value="@customer.Id">
                            @customer.Name @customer.Surname
                        </option>
                    }
                </select>

                <span asp-validation-for="CustomerId"
                      class="text-danger">
                </span>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex
                justify-content-between
                align-items-center">

                <span>Order Items</span>

                <button type="button"
                        id="addItemButton"
                        class="btn btn-sm btn-success">
                    Add Product
                </button>
            </div>

            <div class="card-body">
                <div id="orderItemsContainer">
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        <div class="order-item row g-3
                            align-items-end mb-3">

                            <div class="col-md-6">
                                <label class="form-label">
                                    Product
                                </label>

                                <select asp-for="Items[i].ProductId"
                                        class="form-select product-select">
                                    <option value="0">
                                        Select Product
                                    </option>

                                    @foreach (var product in Model.Products)
                                    {
                                        <option value="@product.Id"
                                                data-price="@product.Price">
                                            @product.Name
                                            - @product.Price.ToString("N2") TL
                                            - Stock: @product.Stock
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="Items[i].ProductId"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">
                                    Quantity
                                </label>

                                <input asp-for="Items[i].Quantity"
                                       class="form-control quantity-input"
                                       min="1" />

                                <span asp-validation-for="Items[i].Quantity"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-3">
                                <button type="button"
                                        class="btn btn-outline-danger
                                    remove-item-button">
                                    Remove
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div id="emptyOrderMessage"
                     class="alert alert-secondary">
                    Click “Add Product” to add an order item.
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a href="@Url.Action("Index", "Order")"
               class="btn btn-outline-secondary">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Save Order
            </button>
        </div>
    </form>
</div>

<template id="orderItemTemplate">
    <div class="order-item row g-3
        align-items-end mb-3">

        <div class="col-md-6">
            <label class="form-label">
                Product
            </label>

            <select class="form-select product-select"
                    data-field="ProductId">

                <option value="0">
                    Select Product
                </option>

                @foreach (var product in Model.Products)
                {
                    <option value="@product.Id"
                            data-price="@product.Price">
                        @product.Name
                        - @product.Price.ToString("N2") TL
                        - Stock: @product.Stock
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">
                Quantity
            </label>

            <input type="number"
                   class="form-control quantity-input"
                   data-field="Quantity"
                   value="1"
                   min="1" />
        </div>

        <div class="col-md-3">
            <button type="button"
                    class="btn btn-outline-danger
                remove-item-button">
                Remove
            </button>
        </div>
    </div>
</template>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        const container =
            document.getElementById("orderItemsContainer");

        const template =
            document.getElementById("orderItemTemplate");

        const addButton =
            document.getElementById("addItemButton");

        const emptyMessage =
            document.getElementById("emptyOrderMessage");

        function updateIndexes() {
            const items =
                container.querySelectorAll(".order-item");

            items.forEach((item, index) => {
                const product =
                    item.querySelector('[data-field="ProductId"]');

                const quantity =
                    item.querySelector('[data-field="Quantity"]');

                if (product) {
                    product.name =
                        `Items[${index}].ProductId`;

                    product.id =
                        `Items_${index}__ProductId`;
                }

                if (quantity) {
                    quantity.name =
                        `Items[${index}].Quantity`;

                    quantity.id =
                        `Items_${index}__Quantity`;
                }
            });

            emptyMessage.style.display =
                items.length === 0 ? "block" : "none";
        }

        function addItem() {
            const clone =
                template.content.cloneNode(true);

            container.appendChild(clone);

            updateIndexes();
        }

        addButton.addEventListener("click", addItem);

        container.addEventListener("click", function (event) {
            if (event.target.classList.contains(
                "remove-item-button")) {

                event.target
                    .closest(".order-item")
                    .remove();

                updateIndexes();
            }
        });

        updateIndexes();
    </script>
}