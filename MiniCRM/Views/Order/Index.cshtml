@model MiniCRM.ViewModels.OrderListViewModel
@inject MiniCRM.Services.IAuthorizationService AuthorizationService
@using System.Linq

@{
    ViewData["Title"] =
        Localization.GetText("Orders");

    var orderSearchPlaceholder =
        Localization.GetText("OrderNumber");

    int? userId =
        Context.Session.GetInt32("UserId");

    bool canCreate =
        userId.HasValue &&
        AuthorizationService.HasPermission(
            userId.Value,
            "Order.Create");

    bool canEdit =
        userId.HasValue &&
        AuthorizationService.HasPermission(
            userId.Value,
            "Order.Edit");
}

<style>

    .order-page {
        --crm-primary: #4f46e5;
        --crm-secondary: #7c3aed;
        --crm-dark: #0f172a;
        --crm-muted: #64748b;
        --crm-border: #e2e8f0;
    }

    .order-header {
        position: relative;
        overflow: hidden;
        padding: 28px;
        border-radius: 20px;
        color: white;
        background: linear-gradient( 135deg, var(--crm-primary), var(--crm-secondary) );
        box-shadow: 0 12px 30px rgba(79, 70, 229, 0.20);
    }

        .order-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            top: -80px;
            right: -45px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.09);
        }

    .order-header-content {
        position: relative;
        z-index: 2;
    }

    .filter-card,
    .order-card {
        overflow: hidden;
        border: 0;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.08);
    }

    .order-page .form-control,
    .order-page .form-select {
        min-height: 42px;
        border-radius: 10px;
        border-color: var(--crm-border);
    }

        .order-page .form-control:focus,
        .order-page .form-select:focus {
            border-color: var(--crm-primary);
            box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.12);
        }

    .order-table thead th {
        padding-top: 14px;
        padding-bottom: 14px;
        color: #475569;
        background: #f8fafc;
        border-bottom: 1px solid var(--crm-border);
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .order-table tbody td {
        padding-top: 15px;
        padding-bottom: 15px;
        vertical-align: middle;
        border-color: #f1f5f9;
    }

    .order-table tbody tr {
        transition: background-color 0.2s ease;
    }

        .order-table tbody tr:hover {
            background: #f8fafc;
        }

    .order-number {
        color: var(--crm-primary);
        font-weight: 800;
    }

    .customer-name {
        color: var(--crm-dark);
        font-weight: 650;
    }

    .customer-number {
        color: var(--crm-muted);
        font-size: 0.84rem;
    }

    .price-text {
        color: var(--crm-dark);
        font-weight: 750;
        white-space: nowrap;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 11px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 650;
        white-space: nowrap;
    }

    .status-draft {
        color: #92400e;
        background: #fef3c7;
    }

    .status-completed {
        color: #166534;
        background: #dcfce7;
    }

    .status-cancelled {
        color: #991b1b;
        background: #fee2e2;
    }

    .action-button {
        border-radius: 9px;
        white-space: nowrap;
    }

    .result-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 32px;
        padding: 0 12px;
        border-radius: 999px;
        color: var(--crm-primary);
        background: #eef2ff;
        font-weight: 700;
    }

    .pagination .page-link {
        margin: 0 3px;
        border-radius: 10px;
        color: var(--crm-primary);
        border-color: var(--crm-border);
    }

    .pagination
    .page-item.active
    .page-link {
        color: white;
        background: var(--crm-primary);
        border-color: var(--crm-primary);
    }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
        color: var(--crm-muted);
    }

    .empty-state-icon {
        width: 62px;
        height: 62px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        border-radius: 18px;
        color: var(--crm-primary);
        background: #eef2ff;
        font-size: 1.4rem;
        font-weight: 800;
    }

</style>

<div class="container-fluid py-4 order-page">

    <!-- Header -->

    <div class="order-header mb-4">

        <div class="order-header-content">

            <div class="d-flex
                flex-column
                flex-lg-row
                justify-content-between
                align-items-lg-center
                gap-3">

                <div>

                    <h1 class="h3 fw-bold mb-2">
                        @Localization.GetText("OrderManagement")
                    </h1>

                    <p class="mb-0 opacity-75">
                        @Localization.GetText(
                            "OrderManagementPageDescription")
                    </p>

                </div>

                @if (canCreate)
                {
                    <div>

                        <a asp-controller="Order"
                           asp-action="Create"
                           class="btn btn-light
                            fw-semibold
                            px-4 py-2">

                            + @Localization.GetText(
                                                            "CreateNewOrder")

                        </a>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success
            alert-dismissible
            fade show shadow-sm">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger
            alert-dismissible
            fade show shadow-sm">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Filters -->

    <div class="card filter-card mb-4">

        <div class="card-header
            bg-white
            border-0
            px-4 pt-4 pb-0">

            <h2 class="h5 fw-bold mb-1">
                @Localization.GetText("OrderFilters")
            </h2>

        </div>

        <div class="card-body p-4">

            <form asp-controller="Order"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <!-- Search -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <label class="form-label fw-semibold">
                            @Localization.GetText("OrderSearch")
                        </label>

                        <input type="text"
                               name="search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="@orderSearchPlaceholder" />

                    </div>


                    <!-- Customer -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <label class="form-label fw-semibold">
                            @Localization.GetText("Customer")
                        </label>

                        <select name="customerId"
                                class="form-select">

                            <option value="">
                                @Localization.GetText("AllCustomers")
                            </option>

                            @foreach (var customer in Model.Customers)
                            {
                                if (Model.CustomerId == customer.Id)
                                {
                                    <option value="@customer.Id"
                                            selected>

                                        @customer.Name
                                        @customer.Surname

                                    </option>
                                }
                                else
                                {
                                    <option value="@customer.Id">

                                        @customer.Name
                                        @customer.Surname

                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- Status -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <label class="form-label fw-semibold">
                            @Localization.GetText("Status")
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                @Localization.GetText("AllStatuses")
                            </option>

                            @foreach (
                                var status in
                                Enum.GetValues<
                                    MiniCRM.Models.Order.OrderStatus>())
                            {
                                string statusText =
                                    status switch
                                    {
                                        MiniCRM.Models.Order
                                            .OrderStatus.Draft =>
                                            Localization.GetText(
                                                "StatusDraft"),

                                        MiniCRM.Models.Order
                                            .OrderStatus.Completed =>
                                            Localization.GetText(
                                                "StatusCompleted"),

                                        MiniCRM.Models.Order
                                            .OrderStatus.Cancelled =>
                                            Localization.GetText(
                                                "StatusCancelled"),

                                        _ => status.ToString()
                                    };

                                if (Model.Status == status)
                                {
                                    <option value="@status"
                                            selected>
                                        @statusText
                                    </option>
                                }
                                else
                                {
                                    <option value="@status">
                                        @statusText
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- Start Date -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <label class="form-label fw-semibold">
                            @Localization.GetText("StartDate")
                        </label>

                        <input type="date"
                               name="startDate"
                               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>


                    <!-- End Date -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <label class="form-label fw-semibold">
                            @Localization.GetText("EndDate")
                        </label>

                        <input type="date"
                               name="endDate"
                               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>


                    <!-- Minimum -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <label class="form-label fw-semibold">
                            @Localization.GetText("MinAmount")
                        </label>

                        <input type="number"
                               name="minAmount"
                               value="@Model.MinAmount"
                               min="0"
                               step="0.01"
                               class="form-control"
                               placeholder="10000" />

                    </div>


                    <!-- Maximum -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <label class="form-label fw-semibold">
                            @Localization.GetText("MaxAmount")
                        </label>

                        <input type="number"
                               name="maxAmount"
                               value="@Model.MaxAmount"
                               min="0"
                               step="0.01"
                               class="form-control"
                               placeholder="100000" />

                    </div>


                    <!-- Buttons -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <div class="d-grid d-md-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-grow-1">

                                @Localization.GetText("Filter")

                            </button>

                            <a asp-controller="Order"
                               asp-action="Index"
                               class="btn
                                btn-outline-secondary
                                flex-grow-1">

                                @Localization.GetText("Clear")

                            </a>

                        </div>

                    </div>

                </div>

                <input type="hidden"
                       name="pageSize"
                       value="@Model.PageSize" />

            </form>

        </div>

    </div>


    <!-- Order List -->

    <div class="card order-card">

        <div class="card-header
            bg-white
            border-0
            p-4">

            <div class="d-flex
                flex-column
                flex-md-row
                justify-content-between
                align-items-md-center
                gap-2">

                <div>

                    <h2 class="h5 fw-bold mb-1">
                        @Localization.GetText("Orders")
                    </h2>

                    <span class="text-secondary">

                        @Localization.GetText("TotalResults"):

                        <strong>
                            @Model.TotalCount
                        </strong>

                    </span>

                </div>

                <div class="d-flex
                    align-items-center
                    gap-3">

                    <span class="result-count">
                        @Model.TotalCount
                    </span>

                    @if (Model.TotalPages > 0)
                    {
                        <span class="text-secondary">

                            @Localization.GetText("Page")

                            <strong>@Model.CurrentPage</strong>

                            /

                            <strong>@Model.TotalPages</strong>

                        </span>
                    }

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Orders.Count == 0)
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        S
                    </div>

                    <h3 class="h5 fw-bold text-dark">

                        @Localization.GetText(
                            "NoOrdersForFilters")

                    </h3>

                    <a asp-controller="Order"
                       asp-action="Index"
                       class="btn
                        btn-outline-primary
                        mt-2">

                        @Localization.GetText("Clear")

                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table
                        order-table
                        align-middle
                        mb-0">

                        <thead>

                            <tr>

                                <th class="ps-4">
                                    @Localization.GetText(
                                        "OrderNumber")
                                </th>

                                <th>
                                    @Localization.GetText(
                                        "Customer")
                                </th>

                                <th>
                                    @Localization.GetText(
                                        "OrderDate")
                                </th>

                                <th>
                                    @Localization.GetText(
                                        "TotalAmount")
                                </th>

                                <th>
                                    @Localization.GetText(
                                        "Status")
                                </th>

                                <th class="text-end pe-4">
                                    @Localization.GetText(
                                        "Actions")
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var order in Model.Orders)
                            {
                                var customer =
                                    Model.Customers
                                        .FirstOrDefault(
                                            x =>
                                            x.Id ==
                                            order.CustomerId);

                                string statusClass =
                                    order.Status switch
                                    {
                                        MiniCRM.Models.Order
                                            .OrderStatus.Draft =>
                                            "status-draft",

                                        MiniCRM.Models.Order
                                            .OrderStatus.Completed =>
                                            "status-completed",

                                        MiniCRM.Models.Order
                                            .OrderStatus.Cancelled =>
                                            "status-cancelled",

                                        _ => ""
                                    };

                                string statusText =
                                    order.Status switch
                                    {
                                        MiniCRM.Models.Order
                                            .OrderStatus.Draft =>
                                            Localization.GetText(
                                                "StatusDraft"),

                                        MiniCRM.Models.Order
                                            .OrderStatus.Completed =>
                                            Localization.GetText(
                                                "StatusCompleted"),

                                        MiniCRM.Models.Order
                                            .OrderStatus.Cancelled =>
                                            Localization.GetText(
                                                "StatusCancelled"),

                                        _ =>
                                            order.Status.ToString()
                                    };

                                <tr>

                                    <td class="ps-4">

                                        <span class="order-number">
                                            #@order.Id
                                        </span>

                                    </td>


                                    <td>

                                        <div class="customer-name">

                                            @(customer == null
                                                ? "-"
                                                : customer.Name
                                                  + " "
                                                  + customer.Surname)

                                        </div>

                                        <div class="customer-number">

                                            @Localization.GetText(
                                                "CustomerId"):
                                            #@order.CustomerId

                                        </div>

                                    </td>


                                    <td>

                                        <span class="text-secondary">

                                            @(order.OrderDate
                                                .ToString(
                                                    "dd/MM/yyyy"))

                                        </span>

                                    </td>


                                    <td>

                                        <span class="price-text">

                                            @(order.TotalAmount.ToString("N2")) TL
                                        </span>

                                    </td>


                                    <td>

                                        <span class="status-badge
                                            @statusClass">

                                            ● @statusText

                                        </span>

                                    </td>


                                    <td class="text-end pe-4">

                                        <div class="d-inline-flex
                                            flex-wrap
                                            justify-content-end
                                            gap-2">

                                            <a asp-controller="Order"
                                               asp-action="Details"
                                               asp-route-id="@order.Id"
                                               class="btn
                                                btn-sm
                                                btn-outline-info
                                                action-button">

                                                @Localization.GetText(
                                                    "Details")

                                            </a>


                                            @if (
                                                canEdit &&
                                                order.Status ==
                                                MiniCRM.Models.Order
                                                    .OrderStatus.Draft)
                                            {
                                                <a asp-controller="Order"
                                                   asp-action="Update"
                                                   asp-route-id="@order.Id"
                                                   class="btn
                                                    btn-sm
                                                    btn-outline-primary
                                                    action-button">

                                                    @Localization.GetText(
                                                        "Update")

                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>


        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer
                bg-white
                border-0
                p-4">

                <nav>

                    <ul class="pagination
                        justify-content-center
                        flex-wrap
                        mb-0">

                        <li class="page-item
                            @(Model.CurrentPage <= 1
                                ? "disabled"
                                : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-customerId="@Model.CustomerId"
                               asp-route-status="@Model.Status"
                               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                               asp-route-minAmount="@Model.MinAmount"
                               asp-route-maxAmount="@Model.MaxAmount"
                               asp-route-pageNumber="@(Model.CurrentPage - 1)"
                               asp-route-pageSize="@Model.PageSize">

                                @Localization.GetText("Previous")

                            </a>

                        </li>


                        @for (
                            int pageNumberItem = 1;
                            pageNumberItem <= Model.TotalPages;
                            pageNumberItem++)
                        {
                            <li class="page-item
                                @(pageNumberItem ==
                                   Model.CurrentPage
                                    ? "active"
                                    : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-search="@Model.Search"
                                   asp-route-customerId="@Model.CustomerId"
                                   asp-route-status="@Model.Status"
                                   asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                                   asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                                   asp-route-minAmount="@Model.MinAmount"
                                   asp-route-maxAmount="@Model.MaxAmount"
                                   asp-route-pageNumber="@pageNumberItem"
                                   asp-route-pageSize="@Model.PageSize">

                                    @pageNumberItem

                                </a>

                            </li>
                        }


                        <li class="page-item
                            @(Model.CurrentPage >=
                               Model.TotalPages
                                ? "disabled"
                                : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-customerId="@Model.CustomerId"
                               asp-route-status="@Model.Status"
                               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                               asp-route-minAmount="@Model.MinAmount"
                               asp-route-maxAmount="@Model.MaxAmount"
                               asp-route-pageNumber="@(Model.CurrentPage + 1)"
                               asp-route-pageSize="@Model.PageSize">

                                @Localization.GetText("Next")

                            </a>

                        </li>

                    </ul>

                </nav>

            </div>
        }

    </div>

</div>