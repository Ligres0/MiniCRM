@model List<MiniCRM.ViewModels.UserActivityLogListViewModel>

@{
    ViewData["Title"] = "Aktivite Geçmişi";
}

<style>

    .activity-page {
        --primary: #4f46e5;
        --purple: #7c3aed;
        --dark: #0f172a;
        --muted: #64748b;
        --border: #e2e8f0;
    }

    .activity-header {
        padding: 30px 32px;
        margin-bottom: 24px;
        border-radius: 22px;
        color: white;
        background: linear-gradient( 135deg, #4f46e5, #7c3aed );
        box-shadow: 0 18px 40px rgba(79, 70, 229, 0.20);
    }

        .activity-header h1 {
            margin-bottom: 6px;
            font-size: 1.75rem;
            font-weight: 800;
        }

        .activity-header p {
            margin-bottom: 0;
            color: rgba(255, 255, 255, 0.82);
        }

    .activity-card {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: white;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.07);
    }

    .activity-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
    }

        .activity-card-header h2 {
            margin-bottom: 4px;
            color: var(--dark);
            font-size: 1.1rem;
            font-weight: 750;
        }

        .activity-card-header p {
            margin-bottom: 0;
            color: var(--muted);
            font-size: 0.87rem;
        }

    .activity-table {
        margin-bottom: 0;
    }

        .activity-table thead th {
            padding: 15px 20px;
            color: #475569;
            background: #f8fafc;
            border-bottom: 1px solid var(--border);
            font-size: 0.82rem;
            font-weight: 750;
        }

        .activity-table tbody td {
            padding: 16px 20px;
            vertical-align: middle;
            border-color: #f1f5f9;
        }

        .activity-table tbody tr:hover {
            background: #fafafa;
        }

    .user-name {
        color: var(--dark);
        font-weight: 700;
    }

    .description-text {
        color: #475569;
    }

    .date-text {
        color: var(--muted);
        white-space: nowrap;
        font-size: 0.85rem;
    }

    .action-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 750;
    }

    .action-login {
        color: #166534;
        background: #dcfce7;
    }

    .action-logout {
        color: #475569;
        background: #f1f5f9;
    }

    .action-user {
        color: #1d4ed8;
        background: #dbeafe;
    }

    .action-role {
        color: #6d28d9;
        background: #ede9fe;
    }

    .action-permission {
        color: #9a3412;
        background: #ffedd5;
    }

    .action-default {
        color: #334155;
        background: #e2e8f0;
    }

    .empty-state {
        padding: 50px 20px;
        text-align: center;
        color: var(--muted);
    }

    .btn-back {
        text-decoration: none;
    }

    @@media (max-width: 767px) {

        .activity-header {
            padding: 24px 20px;
        }

        .activity-card-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }
    }

</style>


<div class="container py-4 activity-page">

    <section class="activity-header">

        <span class="badge bg-light text-primary mb-2">
            Yönetim Paneli
        </span>

        <h1>
            Aktivite Geçmişi
        </h1>

        <p>
            Kullanıcıların sistem üzerinde gerçekleştirdiği önemli işlemleri görüntüleyin.
        </p>

    </section>


    <section class="activity-card">

        <div class="activity-card-header">

            <div>

                <h2>
                    Kullanıcı Aktiviteleri
                </h2>

                <p>
                    En son işlemler en üstte gösterilir.
                </p>

            </div>


            <a asp-controller="User"
               asp-action="Index"
               class="btn btn-outline-secondary btn-back">

                Kullanıcı Yönetimine Dön

            </a>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table activity-table">

                    <thead>

                        <tr>

                            <th>
                                Tarih
                            </th>

                            <th>
                                Kullanıcı
                            </th>

                            <th>
                                İşlem
                            </th>

                            <th>
                                Açıklama
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var log in Model)
                        {
                            string actionClass =
                                log.Action switch
                                {
                                    "Login"
                                        => "action-login",

                                    "Logout"
                                        => "action-logout",

                                    "UserCreated"
                                        => "action-user",

                                    "UserRolesUpdated"
                                        => "action-user",

                                    "RoleCreated"
                                        => "action-role",

                                    "RolePermissionsUpdated"
                                        => "action-permission",

                                    _
                                        => "action-default"
                                };


                            <tr>

                                <td>

                                    <span class="date-text">

                                        @log.CreatedDate.ToString(
                                            "dd.MM.yyyy HH:mm")

                                    </span>

                                </td>


                                <td>

                                    <span class="user-name">
                                        @log.UserName
                                    </span>

                                </td>


                                <td>

                                    <span class="
                                        action-badge
                                        @actionClass">

                                        @log.Action

                                    </span>

                                </td>


                                <td>

                                    <span class="description-text">

                                        @(string.IsNullOrWhiteSpace(
                                            log.Description)
                                            ? "-"
                                            : log.Description)

                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <h5 class="fw-bold">
                    Henüz aktivite bulunmuyor.
                </h5>

                <p class="mb-0">
                    Kullanıcılar sistemde işlem yaptıkça kayıtlar burada görünecek.
                </p>

            </div>
        }

    </section>

</div>