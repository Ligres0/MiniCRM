@model MiniCRM.ViewModels.ProductListViewModel
@inject MiniCRM.Services.IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = Localization.GetText("Products");

    var productSearchPlaceholder =
        Localization.GetText("ProductSearchPlaceholder");

    var deactivateMessage =
        Localization.GetText("ConfirmDeactivateProduct");

    int? userId = Context.Session.GetInt32("UserId");

    bool canCreate =
        userId.HasValue &&
        AuthorizationService.HasPermission(
            userId.Value,
            "Product.Create");

    bool canEdit =
        userId.HasValue &&
        AuthorizationService.HasPermission(
            userId.Value,
            "Product.Edit");

    bool canDelete =
        userId.HasValue &&
        AuthorizationService.HasPermission(
            userId.Value,
            "Product.Delete");
}

<div class="container py-4">

    <div class="d-flex
        flex-column
        flex-md-row
        justify-content-between
        align-items-md-center
        gap-3
        mb-4">

        <div>

            <h1 class="fw-bold mb-1">
                @Localization.GetText("Products")
            </h1>

            <p class="text-muted mb-0">
                @Localization.GetText("ProductManagementPageDescription")
            </p>

        </div>

        @if (canCreate)
        {
            <a asp-controller="Product"
               asp-action="Create"
               class="btn btn-primary">

                + @Localization.GetText("NewProduct")

            </a>
        }

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <form asp-controller="Product"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-4">

                        <label asp-for="Search"
                               class="form-label fw-semibold">

                            @Localization.GetText("ProductSearch")

                        </label>

                        <input asp-for="Search"
                               class="form-control"
                               placeholder="@productSearchPlaceholder" />

                    </div>

                    <div class="col-md-3">

                        <label asp-for="CategoryId"
                               class="form-label fw-semibold">

                            @Localization.GetText("Category")

                        </label>

                        <select asp-for="CategoryId"
                                class="form-select">

                            <option value="">
                                @Localization.GetText("AllCategories")
                            </option>

                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id">
                                    @category.Name
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-2">

                        <label asp-for="IsActive"
                               class="form-label fw-semibold">

                            @Localization.GetText("Status")

                        </label>

                        <select asp-for="IsActive"
                                class="form-select">

                            <option value="">
                                @Localization.GetText("All")
                            </option>

                            <option value="true">
                                @Localization.GetText("Active")
                            </option>

                            <option value="false">
                                @Localization.GetText("Inactive")
                            </option>

                        </select>

                    </div>

                    <div class="col-md-3">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-grow-1">

                                @Localization.GetText("Filter")

                            </button>

                            <a asp-controller="Product"
                               asp-action="Index"
                               class="btn btn-outline-secondary flex-grow-1">

                                @Localization.GetText("Clear")

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- Product list -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex justify-content-between">

                <div>

                    <h2 class="h5 fw-bold mb-1">
                        @Localization.GetText("ProductList")
                    </h2>

                    <span class="text-muted">

                        @Localization.GetText("TotalProducts"):
                        @Model.TotalCount

                    </span>

                </div>

                @if (Model.TotalPages > 0)
                {
                    <span class="text-muted">

                        @Localization.GetText("Page")
                        @Model.CurrentPage
                        /
                        @Model.TotalPages

                    </span>
                }

            </div>

        </div>

        <div class="card-body p-0">

            @if (Model.Products.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    @Localization.GetText("Product")
                                </th>

                                <th>
                                    @Localization.GetText("Category")
                                </th>

                                <th>
                                    @Localization.GetText("Price")
                                </th>

                                <th>
                                    @Localization.GetText("Stock")
                                </th>

                                <th>
                                    @Localization.GetText("Status")
                                </th>

                                <th>
                                    @Localization.GetText("CreatedDate")
                                </th>

                                <th class="text-end pe-4">
                                    @Localization.GetText("Actions")
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var product in Model.Products)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <strong>
                                            @product.Name
                                        </strong>

                                        <div class="small text-muted">

                                            @Localization.GetText("ProductNumber"):
                                            #@product.Id

                                        </div>

                                    </td>

                                    <td>

                                        @(string.IsNullOrWhiteSpace(product.CategoryName)
                                            ? "-"
                                            : product.CategoryName)

                                    </td>

                                    <td>
                                        @product.Price.ToString("N2") ₺
                                    </td>

                                    <td>

                                        @if (product.Stock == 0)
                                        {
                                            <span class="badge bg-danger">

                                                @Localization.GetText("OutOfStock")

                                            </span>
                                        }
                                        else if (product.Stock <= 5)
                                        {
                                            <span class="badge bg-warning text-dark">

                                                @Localization.GetText("Critical"):
                                                @product.Stock

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">

                                                @product.Stock
                                                @Localization.GetText("UnitsInStock")

                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (product.IsActive)
                                        {
                                            <span class="badge bg-success">

                                                @Localization.GetText("Active")

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                @Localization.GetText("Inactive")

                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @product.CreatedDate.ToString("dd.MM.yyyy")
                                    </td>

                                    
                                        <td class="text-end pe-4">

                                            <a asp-controller="Product"
                                               asp-action="Details"
                                               asp-route-id="@product.Id"
                                               class="btn btn-sm btn-outline-info">

                                                @Localization.GetText("Details")

                                            </a>

                                            @if (canEdit)
                                            {
                                                <a asp-controller="Product"
                                                   asp-action="Update"
                                                   asp-route-id="@product.Id"
                                                   class="btn btn-sm btn-outline-primary">

                                                    @Localization.GetText("Edit")

                                                </a>
                                            }

                                            @if (canDelete && product.IsActive)
                                            {
                                                <form asp-controller="Product"
                                                      asp-action="Deactivate"
                                                      asp-route-id="@product.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('@deactivateMessage');">

                                                        @Localization.GetText("Deactivate")

                                                    </button>

                                                </form>
                                            }

                                        </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h3 class="h5">
                        @Localization.GetText("NoProductsFound")
                    </h3>

                    <p class="text-muted">
                        @Localization.GetText("NoProductsDescription")
                    </p>

                    @if (canCreate)
                    {
                        <a asp-controller="Product"
                           asp-action="Create"
                           class="btn btn-primary">

                            @Localization.GetText("CreateProduct")

                        </a>
                    }

                </div>
            }

        </div>


        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 p-4">

                <nav>

                    <ul class="pagination justify-content-center mb-0">

                        <li class="page-item
                            @(Model.CurrentPage == 1
                                ? "disabled"
                                : "")">

                            <a class="page-link"
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-pageNumber="@(Model.CurrentPage - 1)"
                               asp-route-search="@Model.Search"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-isActive="@Model.IsActive">

                                @Localization.GetText("Previous")

                            </a>

                        </li>

                        @for (int pageNumber = 1;
                              pageNumber <= Model.TotalPages;
                              pageNumber++)
                        {
                            <li class="page-item
                                @(pageNumber == Model.CurrentPage
                                    ? "active"
                                    : "")">

                                <a class="page-link"
                                   asp-controller="Product"
                                   asp-action="Index"
                                   asp-route-pageNumber="@pageNumber"
                                   asp-route-search="@Model.Search"
                                   asp-route-categoryId="@Model.CategoryId"
                                   asp-route-isActive="@Model.IsActive">

                                    @pageNumber

                                </a>

                            </li>
                        }

                        <li class="page-item
                            @(Model.CurrentPage == Model.TotalPages
                                ? "disabled"
                                : "")">

                            <a class="page-link"
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-pageNumber="@(Model.CurrentPage + 1)"
                               asp-route-search="@Model.Search"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-isActive="@Model.IsActive">

                                @Localization.GetText("Next")

                            </a>

                        </li>

                    </ul>

                </nav>

            </div>
        }

    </div>

</div>