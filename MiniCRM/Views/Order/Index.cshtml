@model MiniCRM.ViewModels.OrderListViewModel

@{
    ViewData["Title"] = "Orders";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Order Management</h2>
            <p class="text-muted mb-0">
                Manage and filter customer orders.
            </p>
        </div>

        <a asp-controller="Order"
           asp-action="Create"
           class="btn btn-primary">
            Create New Order
        </a>
    </div>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Validation Errors -->
    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">
            <h5 class="mb-0">
                Order Filters
            </h5>
        </div>

        <div class="card-body">

            <form asp-controller="Order"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label">
                            Order Search
                        </label>

                        <input type="text"
                               name="search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="Order number" />

                    </div>

                    <!-- Customer -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label">
                            Customer
                        </label>

                        <select name="customerId"
                                class="form-select">

                            <option value="">
                                All Customers
                            </option>

                            @foreach (var customer in Model.Customers)
                            {
                                if (Model.CustomerId == customer.Id)
                                {
                                    <option value="@customer.Id" selected>
                                        @customer.Name @customer.Surname
                                    </option>
                                }
                                else
                                {
                                    <option value="@customer.Id">
                                        @customer.Name @customer.Surname
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <!-- Status -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All Statuses
                            </option>

                            @foreach (var status in Enum.GetValues<
                                MiniCRM.Models.Order.OrderStatus>())
                            {
                                if (Model.Status == status)
                                {
                                    <option value="@status" selected>
                                        @status
                                    </option>
                                }
                                else
                                {
                                    <option value="@status">
                                        @status
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <!-- Start Date -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label">
                            Start Date
                        </label>

                        <input type="date"
                               name="startDate"
                               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>

                    <!-- End Date -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label">
                            End Date
                        </label>

                        <input type="date"
                               name="endDate"
                               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                               class="form-control" />

                    </div>

                    <!-- Min Amount -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label">
                            Min. Amount
                        </label>

                        <input type="number"
                               name="minAmount"
                               value="@Model.MinAmount"
                               min="0"
                               step="0.01"
                               class="form-control"
                               placeholder="10000" />

                    </div>

                    <!-- Max Amount -->
                    <div class="col-md-6 col-lg-3">

                        <label class="form-label">
                            Max. Amount
                        </label>

                        <input type="number"
                               name="maxAmount"
                               value="@Model.MaxAmount"
                               min="0"
                               step="0.01"
                               class="form-control"
                               placeholder="100000" />

                    </div>

                    <!-- Buttons -->
                    <div class="col-md-6 col-lg-3 d-flex align-items-end gap-2">

                        <button type="submit"
                                class="btn btn-dark">
                            Filter
                        </button>

                        <a asp-controller="Order"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Clear
                        </a>

                    </div>

                </div>

                <input type="hidden"
                       name="pageSize"
                       value="@Model.PageSize" />

            </form>

        </div>

    </div>

    <!-- Result Info -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div class="text-muted">
            Total Results:
            <strong>@Model.TotalCount</strong>
        </div>

        @if (Model.TotalPages > 0)
        {
            <div class="text-muted">
                Page
                <strong>@Model.CurrentPage</strong>
                of
                <strong>@Model.TotalPages</strong>
            </div>
        }

    </div>

    <!-- Orders Table -->
    <div class="card shadow-sm">

        <div class="card-body">

            @if (Model.Orders.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No orders were found for the selected filters.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Order No</th>
                                <th>Customer ID</th>
                                <th>Order Date</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                                <th class="text-end">
                                    Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var order in Model.Orders)
                            {
                                <tr>

                                    <td>
                                        #@order.Id
                                    </td>

                                    <td>
                                        @order.CustomerId
                                    </td>

                                    <td>
                                        @order.OrderDate.ToString(
                                            "dd.MM.yyyy HH:mm")
                                    </td>

                                    <td>
                                        @order.TotalAmount.ToString("N2") TL
                                    </td>

                                    <td>

                                        @if (order.Status ==
                                            MiniCRM.Models.Order.OrderStatus.Draft)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Draft
                                            </span>
                                        }
                                        else if (order.Status ==
                                            MiniCRM.Models.Order.OrderStatus.Completed)
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Details"
                                           asp-route-id="@order.Id"
                                           class="btn btn-sm btn-outline-info">
                                            Details
                                        </a>

                                        @if (order.Status ==
                                            MiniCRM.Models.Order.OrderStatus.Draft)
                                        {
                                            <a asp-action="Update"
                                               asp-route-id="@order.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Update
                                            </a>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4">

            <ul class="pagination justify-content-center">

                <!-- Previous -->
                <li class="page-item
                    @(Model.CurrentPage <= 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-customerId="@Model.CustomerId"
                       asp-route-status="@Model.Status"
                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                       asp-route-minAmount="@Model.MinAmount"
                       asp-route-maxAmount="@Model.MaxAmount"
                       asp-route-pageNumber="@(Model.CurrentPage - 1)"
                       asp-route-pageSize="@Model.PageSize">

                        Previous

                    </a>

                </li>

                <!-- Page Numbers -->
                @for (int pageNumberItem = 1;
                      pageNumberItem <= Model.TotalPages;
                      pageNumberItem++)
                {
                    <li class="page-item
                        @(pageNumberItem == Model.CurrentPage
                            ? "active"
                            : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-customerId="@Model.CustomerId"
                           asp-route-status="@Model.Status"
                           asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                           asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                           asp-route-minAmount="@Model.MinAmount"
                           asp-route-maxAmount="@Model.MaxAmount"
                           asp-route-pageNumber="@pageNumberItem"
                           asp-route-pageSize="@Model.PageSize">

                            @pageNumberItem

                        </a>

                    </li>
                }

                <!-- Next -->
                <li class="page-item
                    @(Model.CurrentPage >= Model.TotalPages
                        ? "disabled"
                        : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@Model.Search"
                       asp-route-customerId="@Model.CustomerId"
                       asp-route-status="@Model.Status"
                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                       asp-route-minAmount="@Model.MinAmount"
                       asp-route-maxAmount="@Model.MaxAmount"
                       asp-route-pageNumber="@(Model.CurrentPage + 1)"
                       asp-route-pageSize="@Model.PageSize">

                        Next

                    </a>

                </li>

            </ul>

        </nav>
    }

</div>