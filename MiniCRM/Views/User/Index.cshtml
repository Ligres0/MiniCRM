@model List<MiniCRM.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<style>

    .user-index-page {
        --primary: #4f46e5;
        --primary-light: #eef2ff;
        --purple: #7c3aed;
        --success: #16a34a;
        --success-light: #dcfce7;
        --danger: #dc2626;
        --danger-light: #fee2e2;
        --warning-light: #fef3c7;
        --warning-dark: #92400e;
        --dark: #0f172a;
        --muted: #64748b;
        --border: #e2e8f0;
    }

    .user-index-header {
        position: relative;
        overflow: hidden;
        padding: 30px 32px;
        margin-bottom: 24px;
        border-radius: 22px;
        color: white;
        background: linear-gradient( 135deg, #4f46e5, #7c3aed );
        box-shadow: 0 18px 40px rgba(79, 70, 229, 0.20);
    }

        .user-index-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            top: -80px;
            right: -45px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.10);
        }

    .user-index-header-content {
        position: relative;
        z-index: 2;
    }

    .user-index-header h1 {
        margin-bottom: 6px;
        font-size: 1.75rem;
        font-weight: 800;
    }

    .user-index-header p {
        margin-bottom: 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 0.95rem;
    }

    .user-table-card {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 20px;
        background: white;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.07);
    }

    .user-table-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
    }

        .user-table-header h2 {
            margin-bottom: 4px;
            color: var(--dark);
            font-size: 1.1rem;
            font-weight: 750;
        }

        .user-table-header p {
            margin-bottom: 0;
            color: var(--muted);
            font-size: 0.87rem;
        }

    .btn-create-user {
        padding: 9px 16px;
        border: 0;
        border-radius: 11px;
        color: white;
        background: linear-gradient( 135deg, #4f46e5, #7c3aed );
        font-weight: 700;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .btn-create-user:hover {
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(79, 70, 229, 0.22);
        }

    .user-table {
        margin-bottom: 0;
    }

        .user-table thead th {
            padding: 14px 18px;
            border-bottom: 1px solid var(--border);
            color: var(--muted);
            background: #f8fafc;
            font-size: 0.78rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            white-space: nowrap;
        }

        .user-table tbody td {
            padding: 15px 18px;
            vertical-align: middle;
            border-color: #f1f5f9;
            color: #334155;
        }

        .user-table tbody tr {
            transition: background-color 0.15s ease;
        }

            .user-table tbody tr:hover {
                background: #f8fafc;
            }

    .username-text {
        color: var(--dark);
        font-weight: 700;
    }

    .user-id {
        color: var(--muted);
        font-size: 0.8rem;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 750;
    }

    .status-active {
        color: #166534;
        background: var(--success-light);
    }

    .status-inactive {
        color: #991b1b;
        background: var(--danger-light);
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .role-assigned {
        color: #4338ca;
        background: #eef2ff;
    }

    .role-empty {
        color: var(--warning-dark);
        background: var(--warning-light);
    }

    .btn-role {
        display: inline-block;
        padding: 6px 11px;
        border: 1px solid #c7d2fe;
        border-radius: 9px;
        color: var(--primary);
        background: var(--primary-light);
        font-size: 0.82rem;
        font-weight: 700;
        text-decoration: none;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

        .btn-role:hover {
            color: #3730a3;
            background: #e0e7ff;
        }

    .empty-state {
        padding: 50px 20px;
        text-align: center;
    }

        .empty-state h3 {
            color: var(--dark);
            font-size: 1.05rem;
            font-weight: 750;
        }

        .empty-state p {
            color: var(--muted);
            font-size: 0.9rem;
        }

    @@media (max-width: 767px) {

        .user-index-header {
            padding: 24px 20px;
        }

        .user-table-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .btn-create-user {
            width: 100%;
            text-align: center;
        }
    }

</style>


<div class="container py-4 user-index-page">

    <!-- Header -->

    <section class="user-index-header">

        <div class="user-index-header-content">

            <span class="badge
                bg-light
                text-primary
                px-3
                py-2
                mb-2">

                Yönetim Paneli

            </span>

            <h1>
                Kullanıcı Yönetimi
            </h1>

            <p>
                Sistemdeki kullanıcıları görüntüleyin,
                yeni kullanıcı oluşturun ve rollerini yönetin.
            </p>

        </div>

    </section>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }


    <!-- Kullanıcı Listesi -->

    <section class="user-table-card">

        <div class="user-table-header">

            <div>

                <h2>
                    Kullanıcılar
                </h2>

                <p>
                    Sistemde kayıtlı tüm kullanıcı hesapları
                </p>

            </div>


            <div class="d-flex gap-2">

                <a asp-controller="RolePermission"
                   asp-action="Index"
                   class="btn btn-outline-primary">

                    Rol Yetkileri

                </a>


                <a asp-controller="User"
                   asp-action="Create"
                   class="btn-create-user">

                    + Yeni Kullanıcı

                </a>

            </div>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table user-table">

                    <thead>

                        <tr>

                            <th>
                                Kullanıcı
                            </th>

                            <th>
                                E-posta
                            </th>

                            <th>
                                Durum
                            </th>

                            <th>
                                Kayıt Tarihi
                            </th>

                            <th>
                                Rol
                            </th>

                            <th class="text-end">
                                İşlem
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var user in Model)
                        {
                            <tr>

                                <!-- Kullanıcı -->

                                <td>

                                    <div class="username-text">
                                        @user.UserName
                                    </div>

                                    <div class="user-id">
                                        Kullanıcı #@user.Id
                                    </div>

                                </td>


                                <!-- Email -->

                                <td>

                                    @user.Email

                                </td>


                                <!-- Durum -->

                                <td>

                                    @if (user.IsActive)
                                    {
                                        <span class="status-badge status-active">

                                            Aktif

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">

                                            Pasif

                                        </span>
                                    }

                                </td>


                                <!-- Kayıt Tarihi -->

                                <td>

                                    @user.CreatedDate.ToString(
                                        "dd.MM.yyyy"
                                    )

                                </td>


                                <!-- Rol -->

                                <td>

                                    @if (string.IsNullOrWhiteSpace(
                                        user.RoleNames))
                                    {
                                        <span class="role-badge role-empty">

                                            Rol Atanmamış

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="role-badge role-assigned">

                                            @user.RoleNames

                                        </span>
                                    }

                                </td>


                                <!-- İşlemler -->

                                <td class="text-end">
                                    @if (string.IsNullOrWhiteSpace(
                                        user.RoleNames))
                                    {
                                        <a asp-controller="User"
                                           asp-action="AssignRoles"
                                           asp-route-id="@user.Id"
                                           class="btn-role">

                                            Rol Ata

                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="User"
                                           asp-action="AssignRoles"
                                           asp-route-id="@user.Id"
                                           class="btn-role">

                                            Rol Yönet

                                        </a>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <h3>
                    Kullanıcı bulunamadı
                </h3>

                <p>
                    Sistemde henüz kayıtlı kullanıcı bulunmuyor.
                </p>

                <a asp-controller="User"
                   asp-action="Create"
                   class="btn-create-user">

                    Yeni Kullanıcı Oluştur

                </a>

            </div>
        }

    </section>

</div>