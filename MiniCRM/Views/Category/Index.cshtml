@model List<MiniCRM.Models.Category>
@inject MiniCRM.Services.IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = Localization.GetText("Categories");

    var deactivateMessage =
        Localization.GetText("ConfirmDeactivateCategory");

    int? userId = Context.Session.GetInt32("UserId");

    bool canCreate =
        userId.HasValue &&
        AuthorizationService.HasPermission(
            userId.Value,
            "Product.Create");

    bool canEdit =
        userId.HasValue &&
        AuthorizationService.HasPermission(
            userId.Value,
            "Product.Edit");

    bool canDelete =
        userId.HasValue &&
        AuthorizationService.HasPermission(
            userId.Value,
            "Product.Delete");
}

<style>

    .category-page {
        --crm-primary: #4f46e5;
        --crm-secondary: #7c3aed;
        --crm-dark: #0f172a;
        --crm-muted: #64748b;
        --crm-border: #e2e8f0;
    }

    .category-header {
        position: relative;
        overflow: hidden;
        padding: 28px;
        border-radius: 20px;
        color: white;
        background: linear-gradient( 135deg, var(--crm-primary), var(--crm-secondary) );
        box-shadow: 0 12px 30px rgba(79, 70, 229, 0.20);
    }

        .category-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            top: -80px;
            right: -45px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.09);
        }

    .category-header-content {
        position: relative;
        z-index: 2;
    }

    .category-card {
        overflow: hidden;
        border: 0;
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.08);
    }

    .category-table thead th {
        padding-top: 14px;
        padding-bottom: 14px;
        color: #475569;
        background: #f8fafc;
        border-bottom: 1px solid var(--crm-border);
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .category-table tbody td {
        padding-top: 16px;
        padding-bottom: 16px;
        border-color: #f1f5f9;
        vertical-align: middle;
    }

    .category-table tbody tr {
        transition: background-color 0.2s ease;
    }

        .category-table tbody tr:hover {
            background: #f8fafc;
        }

    .category-avatar {
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 13px;
        color: var(--crm-primary);
        background: #eef2ff;
        font-weight: 800;
    }

    .category-name {
        color: var(--crm-dark);
        font-weight: 700;
    }

    .category-number {
        margin-top: 2px;
        color: var(--crm-muted);
        font-size: 0.85rem;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 11px;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 650;
    }

    .status-active {
        color: #166534;
        background: #dcfce7;
    }

    .status-passive {
        color: #991b1b;
        background: #fee2e2;
    }

    .action-button {
        border-radius: 9px;
        white-space: nowrap;
    }

    .category-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 32px;
        padding: 0 12px;
        border-radius: 999px;
        color: var(--crm-primary);
        background: #eef2ff;
        font-weight: 700;
    }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
        color: var(--crm-muted);
    }

    .empty-state-icon {
        width: 62px;
        height: 62px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        border-radius: 18px;
        color: var(--crm-primary);
        background: #eef2ff;
        font-size: 1.5rem;
        font-weight: 800;
    }

</style>


<div class="container-fluid py-4 category-page">

    <!-- Header -->

    <div class="category-header mb-4">

        <div class="category-header-content">

            <div class="d-flex
                flex-column
                flex-lg-row
                justify-content-between
                align-items-lg-center
                gap-3">

                <div>

                    <h1 class="h3 fw-bold mb-2">

                        @Localization.GetText("Categories")

                    </h1>

                    <p class="mb-0 opacity-75">

                        @Localization.GetText("ManageProductCategories")

                    </p>

                </div>


                @if (canCreate)
                {
                    <div>

                        <a asp-controller="Category"
                           asp-action="Create"
                           class="btn btn-light fw-semibold px-4 py-2">

                            + @Localization.GetText("NewCategory")

                        </a>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert
            alert-success
            alert-dismissible
            fade
            show
            shadow-sm">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert
            alert-danger
            alert-dismissible
            fade
            show
            shadow-sm">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- List -->

    <div class="card category-card">

        <div class="card-header
            bg-white
            border-0
            p-4">

            <div class="d-flex
                justify-content-between
                align-items-center">

                <div>

                    <h2 class="h5 fw-bold mb-1">

                        @Localization.GetText("Categories")

                    </h2>

                    <span class="text-secondary">

                        @Localization.GetText("ManageProductCategories")

                    </span>

                </div>

                <span class="category-count">

                    @Model.Count

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table
                        category-table
                        align-middle
                        mb-0">

                        <thead>

                            <tr>

                                <th class="ps-4">

                                    @Localization.GetText("Name")

                                </th>

                                <th>

                                    @Localization.GetText("Status")

                                </th>

                                <th class="text-end pe-4">

                                    @Localization.GetText("Actions")

                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var category in Model)
                            {
                                string firstLetter =
                                    string.IsNullOrWhiteSpace(category.Name)
                                        ? "?"
                                        : category.Name
                                            .Substring(0, 1)
                                            .ToUpper();

                                <tr>

                                    <!-- Category -->

                                    <td class="ps-4">

                                        <div class="d-flex
                                            align-items-center
                                            gap-3">

                                            <div class="category-avatar">

                                                @firstLetter

                                            </div>


                                            <div>

                                                <div class="category-name">

                                                    @category.Name

                                                </div>

                                                <div class="category-number">

                                                    @Localization.GetText("CategoryId"):
                                                    #@category.Id

                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (category.IsActive)
                                        {
                                            <span class="status-badge
                                                status-active">

                                                ● @Localization.GetText("Active")

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge
                                                status-passive">

                                                ● @Localization.GetText("Inactive")

                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->

                                    <td class="text-end pe-4">

                                        <div class="d-inline-flex
                                            flex-wrap
                                            justify-content-end
                                            gap-2">

                                            <a asp-controller="Category"
                                               asp-action="Details"
                                               asp-route-id="@category.Id"
                                               class="btn
                                                btn-sm
                                                btn-outline-info
                                                action-button">

                                                @Localization.GetText("Details")

                                            </a>


                                            @if (canEdit)
                                            {
                                                <a asp-controller="Category"
                                                   asp-action="Update"
                                                   asp-route-id="@category.Id"
                                                   class="btn
                                                    btn-sm
                                                    btn-outline-primary
                                                    action-button">

                                                    @Localization.GetText("Edit")

                                                </a>
                                            }


                                            @if (canDelete &&
                                                 category.IsActive)
                                            {
                                                <form asp-controller="Category"
                                                      asp-action="Deactivate"
                                                      asp-route-id="@category.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn
                                                        btn-sm
                                                        btn-outline-danger
                                                        action-button"
                                                            onclick="return confirm('@deactivateMessage');">

                                                        @Localization.GetText("Deactivate")

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        K
                    </div>

                    <h3 class="h5 fw-bold text-dark">

                        @Localization.GetText("NoCategoriesFound")

                    </h3>


                    @if (canCreate)
                    {
                        <a asp-controller="Category"
                           asp-action="Create"
                           class="btn btn-primary mt-2">

                            + @Localization.GetText("CreateFirstCategory")

                        </a>
                    }

                </div>
            }

        </div>

    </div>

</div>